/*下面这些就是 Rules_Api 里的函数指针（各自的约定见 rules.hpp）*/
static int count_Rule(){return RULE_COUNT;}/*规则条数（含 0 号“不管”）*/
static const char *get_RuleName(int r){return r>=0&&r<RULE_COUNT?rule_Name[r]:"?";}/*规则的中文名；越界给 "?"*/
static int count_Group(){return GROUP_CNT;}/*规则家族个数*/
static const char *get_GroupName(int g){return g>=0&&g<GROUP_CNT?group_Name_Tab[g]:"?";}/*家族名；越界给 "?"*/
static void reset_Rules(){/*清分类缓存：名字池里的string_view会被外面拿着（Blk_Info.base），所以只能在没有Blk_Info活着的时候调*/
	def_Map.clear();
	def_Pat.clear();
	name_Map.clear();
	name_Pool.clear();
	defaults_Pool.clear();
	full_Props.clear();
	init_Def();
}
static void fill_BlkInfo(Blk_Info *o){/*fixer建段表时每条调色板条目调一次（blk/name/props主机已填）*/
	if(o){
		fill_Info(o);
	}
}
static int get_BlkRule(const Blk_Info *b,uint32_t mask){/*这条要管吗：给规则表下标，-1=不管（mod方块、明确的不管的、被rules=关掉的家族）*/
	int di=get_Def(b);
	if(di<0||di>=defs_len||defs[di].rule==RULE_NONE){
		return -1;
	}
	if(defs[di].set&&!defs[di].set_bit){
		/*这个方块的支撑集没登记进set_List（改规则表时加了个新数组忘了登记）：set_bit=0会让
		  "下面是不是支持集里的一员"永远判不成立⇒这类方块全被当成悬空拆掉。宁可不判这一条
		  （init_Def里已经打印过一行提示），也绝不能因为表写错就整类清空*/
		return -1;
	}
	return (mask&get_DefGroup(defs[di]))?di:-1;
}
static int get_DefRule(int di){/*规则表下标→规则号（report按规则分类计数用）*/
	return di>=0&&di<defs_len?(int)defs[di].rule:(int)RULE_NONE;
}
static int judge_Blk(const Blk_Info *self,int di,Rules_Ctx *c){/*判一格：fixer会填好self/x/y/z和六个面*/
	if(!self||!c||di<0||di>=defs_len){
		return FX_KEEP;
	}
	int r=call_Def(defs[di],*c);
	if(r==FX_KEEP&&!c->blind){
		r=judge_Convert(*c);/*活得下去：再看要不要换成同一族的另一种（藤头/藤身、竹笋/竹子…）*/
	}
	if(r==FX_AIR&&is_Water(self)){
		return set_WaterSource(*c,FX_AIR);/*含水方块/水草海带拆掉，原地留水源*/
	}
	return r;
}
/*计划刻对不对得上（Wiki Chunk_format：block_ticks 的 i 是方块ID，fluid_ticks 的 i 是流体ID）：
  方块刻：这格还是那个方块；
  流体刻：26.1.1 的流体是 water/flowing_water（#water）和 lava/flowing_lava（#lava）——
          Wiki Water/Lava §Data values 的流体表，flowing_* 要到 26.4 才去掉。
          水的看这格装不装水（水、含水方块、海带海草气泡柱），岩浆的看这格是不是岩浆；
          不分源和流动（宁可留着：原版到点发现对不上自己会跳过）。
  别的命名空间的流体（模组）不认识，留着。*/
static bool check_Tick(const Blk_Info *b,bool fluid,std::string_view type){
	if(!b){
		return true;
	}
	if(!fluid){
		return b->name==type;
	}
	if(type=="minecraft:water"||type=="minecraft:flowing_water"){
		return is_Water(b);
	}
	if(type=="minecraft:lava"||type=="minecraft:flowing_lava"){
		return is_VanillaBlk(b)&&b->base=="lava";
	}
	return !is_VanillaName(type);
}
