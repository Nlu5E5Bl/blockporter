     F_TOPCOLL=2048,/*下面顶面有碰撞箱、或者顶面整面就行（海泡菜：中文“拥有可支撑顶面的方块”）*/
     F_COLL=4096,  /*lev=3 时这一面碰撞箱是整面也算（苍白垂须：HangingMossBlock 用 MultifaceBlock.canAttachTo，
