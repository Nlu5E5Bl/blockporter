/*==================== 3. 规则表（哪种方块用哪条规则判） ====================*/
enum{
	RULE_NONE=0,  /*明确不管*/
	RULE_BELOW,   /*下面要支持集里的方块*/
	RULE_2X,      /*两格高：上/下半截互查 + 下半截看下面*/
