     F_ABOVE_KEY=8192};/*上面还得是自己或者 key 那种方块（大型垂滴叶茎：上面是茎或叶子）*/

struct Fix_Def{/*规则表的一行：哪种方块（名字模式）用哪条规则、要什么支撑*/
