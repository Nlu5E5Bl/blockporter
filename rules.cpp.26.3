static bool is_VanillaName(std::string_view n){/*只认minecraft命名空间（没冒号也算），mod方块/流体不猜*/
	if(n.empty()){
		return false;
	}
	size_t c=n.find(':');
	return c==std::string_view::npos||n.substr(0,c)=="minecraft";
}
static bool is_VanillaBlk(const Blk_Info *b){/*这个方块是原版命名空间的*/
	return b&&is_VanillaName(b->name);
}
static const Poi_Info *get_POIInfo(const Blk_Info *b){/*这个方块状态产生什么 POI；不产生（含模组方块、床的脚那半）给 NULL*/
	if(!is_VanillaBlk(b)||b->base.empty()){
		return NULL;
	}
	if(has_Suffix(b->base,"_bed")){/*床只有head那半产生home记录；脚那半返回NULL*/
		return is_PropValue(b,"part","head")?&poi_Home:NULL;
	}
	for(size_t i=0;i<sizeof(poi_Defs)/sizeof(poi_Defs[0]);i++){
		if(b->base==poi_Defs[i].block){
			return poi_Defs[i].info;
		}
	}
	return NULL;
}

