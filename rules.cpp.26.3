	RULE_SNOW,    /*雪层：先看 #cannot_support_snow_layer / #support_override_snow_layer 两个标签，其余要"顶面完整"*/
	RULE_FROST,   /*霜冰：不看支撑，一律换成水（服务端bug/中断留下的一整片霜冰，本该早就化了）*/
	RULE_FALLING, /*重力方块：正下方 FallingBlock.isFree（空气/火/液体/可替换方块）就拆；混凝土粉末碰到水先凝固*/
	RULE_BED,     /*床：另一半（脚在 facing 那边是头，头在反面是脚）得是同一种床、part 相反*/
	RULE_PISTON_HEAD,/*活塞头：背后是同朝向、伸出来的同类活塞（或正在推的 moving_piston）*/
	RULE_PALE_CARPET,/*苍白苔藓地毯：铺地的（bottom=true）下面不是空气；挂在上面那截下面得是铺地的那块；四个侧面照游戏重算*/
	RULE_FIRE,    /*火/灵魂火：下面顶面整面或六邻有可燃的；面按六邻可燃重算；灵魂火只认灵魂沙/灵魂土*/
	RULE_PORTAL,  /*下界传送门：门框平面里的上下/两侧不是传送门也不是黑曜石 → 门不完整*/
	RULE_FENCE,   /*栅栏：四个方向连不连照游戏重算（FenceBlock.connectsTo），不拆*/
	RULE_WALL,    /*墙：四个方向 none/low/tall 和柱子照游戏重算（WallBlock.updateShape），不拆*/
	RULE_BARS,    /*玻璃板/铁栏杆：四个方向连不连照游戏重算（IronBarsBlock.attachsTo），不拆*/
	RULE_GATE,    /*栅栏门：门板两头挨着墙就放低（FenceGateBlock.updateShape 的 in_wall），不拆*/
	RULE_CHEST,   /*箱子：单箱/大箱子的哪一半照游戏重算（ChestBlock/CopperChestBlock.updateShape），不拆*/
	RULE_SNOWY,   /*草方块/灰化土/菌丝：上面是雪就是 snowy（SnowyBlock.updateShape），不拆*/
	RULE_MUSHROOM,/*蘑菇方块/蘑菇柄：挨着同一种方块的面关掉（HugeMushroomBlock.updateShape），不拆*/
	RULE_NOTE,    /*音符盒：音色照上下两格重算（NoteBlock.setInstrument），不拆*/
	RULE_LEAVES,  /*树叶：distance 照六邻重算（LeavesBlock.updateDistance），不拆（distance=7 又不是 persistent 的交给游戏慢慢腐烂）*/
	RULE_COUNT
};
