static const int defs_len=(int)(sizeof(defs)/sizeof(defs[0]));

/*名字→规则：全等的放hash表，带*的面少，线性扫（表里靠前的先匹配，所以更具体的写前面）*/
static std::unordered_map<std::string_view,int> def_Map;
static std::vector<int> def_Pat;
static void init_Def(){/*建名字→规则的表，顺带把每条规则的支持集换成 set_List 里的位；只建一次*/
	if(!def_Map.empty()||!def_Pat.empty()){
		return;
	}
	for(int i=0;i<defs_len;i++){
		const char *n=defs[i].name;
		if(strchr(n,'*')){
			def_Pat.push_back(i);
		}else{
			def_Map[std::string_view(n)]=i;
		}
		if(defs[i].set){/*集合指针→位图里的位：判支持集就不用逐条比名字了*/
			for(int j=0;j<SET_CNT;j++){
				if(set_List[j]==defs[i].set){
					defs[i].set_bit=1u<<j;
					break;
				}
			}
			if(!defs[i].set_bit){
				printf("rules: 规则表里的集合没登记（defs[%d]=%s），支持集判定会失效\n",i,defs[i].name);
			}
		}
	}
}
static int find_Def(std::string_view n){/*方块basename→defs下标，-1=不管*/
	if(n.empty()){
		return -1;
	}
	init_Def();
	std::unordered_map<std::string_view,int>::iterator it=def_Map.find(n);
	if(it!=def_Map.end()){
		return it->second;
	}
	for(size_t i=0;i<def_Pat.size();i++){
		if(match_Pattern(defs[def_Pat[i]].name,n)){
			return def_Pat[i];
		}
	}
	return -1;
}
/*规则家族：规则的粗分类，fixer的 rules= 就是按这些位开关（一个家族一次关掉）*/
enum{G_BELOW=1u<<0,G_2X=1u<<1,G_VINE=1u<<2,G_ATTACH=1u<<3,G_MISC=1u<<4,G_LINK=1u<<5};
static const char *group_Name_Tab[]={"below","2x","vine","attach","misc","link"};
#define GROUP_CNT ((int)(sizeof(group_Name_Tab)/sizeof(group_Name_Tab[0])))
static uint32_t get_DefGroup(const Fix_Def &d){/*这条规则属于哪个家族*/
	switch(d.rule){
	case RULE_BELOW:
	case RULE_RIM:
	case RULE_CHORUS:
	case RULE_PALE_CARPET:
		return G_BELOW;
	case RULE_2X:
	case RULE_BED:
	case RULE_SMALL_DRIPLEAF:
	case RULE_PROPAGULE:
	case RULE_STEM:
		return G_2X;
	case RULE_VINE:
		return G_VINE;
	case RULE_FACE6:
	case RULE_SIDE:
	case RULE_ABOVE:
	case RULE_DRIP:
		return G_ATTACH;
	case RULE_FENCE:
	case RULE_WALL:
	case RULE_BARS:
	case RULE_GATE:
	case RULE_CHEST:
	case RULE_SNOWY:
	case RULE_MUSHROOM:
	case RULE_NOTE:
	case RULE_LEAVES:
		return G_LINK;
	default:
		return G_MISC;
	}
}

