static std::unordered_map<std::string_view,std::string_view> defaults_Map;/*方块名 → 默认状态的属性（"k=v,k=v"）*/
static void init_Defaults(){/*第一次用的时候把 defaults_Blocks 拆开；只建一次*/
	if(!defaults_Map.empty()){
		return;
	}
	for(int i=0;defaults_Blocks[i];i++){
		std::string_view e(defaults_Blocks[i]);
		size_t sp=e.find(' ');
		if(sp!=std::string_view::npos){
			defaults_Map[e.substr(0,sp)]=e.substr(sp+1);
		}
	}
}
static bool is_NameMatch(const char *const *set,std::string_view n){/*名字命中集合里的某一条（可以带一个 *，见 match_Pattern）*/
	for(int i=0;set[i];i++){
		if(match_Pattern(set[i],n)){
			return true;
		}
	}
	return false;
}
static unsigned get_NameLink(std::string_view n){/*CK_*（只给原版名字调）*/
	unsigned k=CK_VANILLA;
	if(is_NameMatch(set_wooden_fence,n)){
		k|=CK_FENCE|CK_WOODEN;
	}else if(n=="nether_brick_fence"){
		k|=CK_FENCE;
	}
	if(is_NameMatch(set_walls,n)){
		k|=CK_WALL;
	}
	if(is_NameMatch(set_bars,n)){
		k|=CK_BARS;
	}
	if(has_Suffix(n,"_fence_gate")){
		k|=CK_GATE;
	}
	if(is_NameMatch(set_nolink,n)){
		k|=CK_NOLINK;
	}
	if(is_NameMatch(set_post_over,n)||(has_Suffix(n,"_sign")&&!has_Suffix(n,"_hanging_sign"))){
		k|=CK_POST;
	}
	return k;
}
static bool is_NameIn(const char *const *set,std::string_view n){/*名字正好等于集合里的某一条（不认 *；材质表那几个大集合用它，比 is_NameMatch 快）*/
	for(int i=0;set[i];i++){
		if(n==set[i]){
			return true;
		}
	}
	return false;
}
static bool is_FreeBelow(const Blk_Info *b){/*FallingBlock.isFree：isAir || #fire || liquid() || canBeReplaced()。
	#fire＝fire/soul_fire，本身就可替换；含水方块（waterlogged）不算液体，也不可替换*/
	if(!b){
		return false;/*读不出来：让调用方当blind处理，绝不能当空气*/
	}
	return (b->flags&BF_AIR)||has_Kind(b,PF_REPLACE|PF_LIQUID);
}
static int get_NameSupport(std::string_view n){/*光看名字能定的支撑档（台阶的双台阶要再看属性，见fill_Info）*/
	if(is_Empty(n)){
		return S_NONE;
	}
	if(is_Thin(n)){
		return S_THIN;
	}
	if(has_Suffix(n,"_slab")){
		return S_PART;
	}
	if(is_Part(n)){
		return S_PART;
	}
	return S_FULL;/*屏障也算整方块：能往上放东西，宁可漏拆*/
}

/*---- 按面的支撑位图（priv[P_SHAPE]） ----
  六个面按 NB_* 编号（东西上下南北）。原版判支撑用到的几种量都在这里算好，规则只查位：
    FULL(d)   isFaceSturdy(d, FULL)：门/海草/墙上火把/按钮/梯子/钟乳石…（FULL 一定也是 CENTER）
    CENTER(d) isFaceSturdy(d, CENTER)：火把/灯笼/蜡烛/吊牌…（原版只在上下两面用 CENTER，侧面的不记）
    RIGID_UP  顶面带边（canSupportRigidBlock）：铁轨/中继器/比较器/压力板（顶面 FULL 一定也是）
    COLL(d)   碰撞箱这一面是满的：藤蔓/发光地衣/幽匿脉络/树脂团认“支撑面满或碰撞面满”（树叶只有碰撞面满）；
              雪层只认碰撞箱顶面（灵魂沙/泥巴/8层雪支撑面满、碰撞箱不满）
    SOLID     legacy isSolid：告示牌/旗帜/蛋糕，仙人掌旁边
    RENDER    整块不透明（isSolidRender）：蘑菇
    TOPCOLL   碰撞箱顶面不是空的：海泡菜
    UNDER(d)  这格放在墙上面时，碰撞箱底面盖住了墙的哪块测试区（WallBlock.isCovered：getFaceShape(DOWN) 盖没盖住
              TEST_SHAPE_POST / TEST_SHAPES_WALL）：d=NB_U 记中间柱子那块（2×2），水平的 d 记朝 d 那条臂（2×9）。
              墙据此定 low/tall 和要不要立柱子（judge_Wall）。碰撞箱底面整面的五块都盖住（fill_Info 统一补）；
              竹子/滴水石锥的碰撞箱随坐标偏移，这里不记，judge_Wall 按坐标现算（get_OffsetUnder）
  依据：游戏自己算的形状（sh test/mcdump.sh <server.jar> shape：在原版 jar 上逐个方块状态问 isFaceSturdy/
  碰撞箱/isSolid/isSolidRender，再和这里逐状态比）。26.1.1 的 29873 个状态全部对齐（侧面的 CENTER 不比）；
  改了这里就重跑一遍，不一致的会逐条列出来。
  只有一处故意不一样：开着的潜影盒（形状靠方块实体，存档里不看）按关着的整方块算，宁可漏拆。*/
enum{SH_CENTER0=6,SH_COLL0=13,SH_UNDER0=22};
static const uint32_t SH_RIGID_UP=1u<<12,SH_SOLID=1u<<19,SH_RENDER=1u<<20,SH_TOPCOLL=1u<<21;
static constexpr uint32_t sh_Full(int d){return (1u<<d)|(1u<<(SH_CENTER0+d))|(1u<<(SH_COLL0+d))|(d==NB_U?(1u<<12):0u);}/*d 面整面：
	顺带也是中心支撑、碰撞面满，顶面的话还带边*/
static constexpr uint32_t sh_Center(int d){return 1u<<(SH_CENTER0+d);}/*d 面中心支撑*/
static constexpr uint32_t sh_Coll(int d){return 1u<<(SH_COLL0+d);}/*d 面碰撞箱是满的*/
static constexpr uint32_t sh_Under(int d){return 1u<<(SH_UNDER0+d);}/*d=NB_U：柱子那块；水平 d：朝 d 那条臂（NB_D 那一位不用）*/
static const uint32_t SH_UNDER_POST=sh_Under(NB_U);
static const uint32_t SH_UNDER_ALL=sh_Under(NB_E)|sh_Under(NB_W)|sh_Under(NB_U)|sh_Under(NB_S)|sh_Under(NB_N);
static const uint32_t SH_CUBE=0x3Fu|(0x3Fu<<SH_CENTER0)|(0x3Fu<<SH_COLL0)|(1u<<12)|(1u<<19)|(1u<<20)|(1u<<21);
static int get_DirIndex(const char *dir);
static int get_OppositeDir(int dir);
/*形状要看属性的几类（台阶/楼梯/门…），fill 时按属性现算*/
enum{SP_NONE=0,SP_SLAB,SP_STAIRS,SP_TRAPDOOR,SP_DOOR,SP_FENCE_GATE,SP_SNOW,SP_CHORUS_PLANT,SP_ROD,SP_LIGHTNING_ROD,
     SP_CHAIN,SP_HOPPER,SP_GRINDSTONE,SP_EPF,SP_BELL,SP_LADDER,SP_AMETHYST,SP_DRIP,SP_LANTERN,SP_CAKE,SP_PITCHER,
     SP_PISTON,SP_PISTON_HEAD,SP_SHELF,SP_WALL,SP_HSIGN,SP_PALE_CARPET,SP_FENCE,SP_CHEST};
static uint32_t calc_NameShape(std::string_view n,int lev,uint8_t *special){/*只看名字能定的形状；要看属性的给 special*/
	*special=SP_NONE;
	if(lev==S_NONE){
		return 0;/*空气/流体/火/传送门：什么都撑不住，也不是 solid*/
	}
	struct Sp{const char *pat;uint8_t sp;};
	static const Sp sps[]={{"*_slab",SP_SLAB},{"*_stairs",SP_STAIRS},{"*_trapdoor",SP_TRAPDOOR},{"*_door",SP_DOOR},
		{"*_fence_gate",SP_FENCE_GATE},{"snow",SP_SNOW},{"chorus_plant",SP_CHORUS_PLANT},{"end_rod",SP_ROD},
		{"lightning_rod",SP_LIGHTNING_ROD},{"*_lightning_rod",SP_LIGHTNING_ROD},{"iron_chain",SP_CHAIN},{"chain",SP_CHAIN},
		{"*_chain",SP_CHAIN},{"hopper",SP_HOPPER},{"grindstone",SP_GRINDSTONE},{"end_portal_frame",SP_EPF},{"bell",SP_BELL},
		{"ladder",SP_LADDER},{"amethyst_cluster",SP_AMETHYST},{"*_amethyst_bud",SP_AMETHYST},{"pointed_dripstone",SP_DRIP},{"sulfur_spike",SP_DRIP},
		{"lantern",SP_LANTERN},{"soul_lantern",SP_LANTERN},{"copper_lantern",SP_LANTERN},{"*_copper_lantern",SP_LANTERN},
		{"cake",SP_CAKE},{"pitcher_crop",SP_PITCHER},{"piston",SP_PISTON},{"sticky_piston",SP_PISTON},
		{"piston_head",SP_PISTON_HEAD},{"*_shelf",SP_SHELF},{"*_wall",SP_WALL},{"*_hanging_sign",SP_HSIGN},
		{"pale_moss_carpet",SP_PALE_CARPET},{"*_fence",SP_FENCE},{"*_pane",SP_FENCE},{"glass_pane",SP_FENCE},
		{"iron_bars",SP_FENCE},{"*_bars",SP_FENCE},{"*chest",SP_CHEST}};
	for(size_t i=0;i<sizeof(sps)/sizeof(sps[0]);i++){
		if(match_Pattern(sps[i].pat,n)){
			*special=sps[i].sp;
			return 0;
		}
	}
	static const uint32_t posts=sh_Center(NB_U)|sh_Center(NB_D)|SH_SOLID|SH_TOPCOLL;/*没列出来的“有形状的”：上下中心支撑*/
	static const uint32_t pads=sh_Center(NB_U)|sh_Center(NB_D)|SH_SOLID|SH_TOPCOLL|SH_UNDER_POST;/*饰纹陶罐/龙蛋/嗅探兽蛋/铁砧：上下中心*/
	static const uint32_t foot=sh_Center(NB_D)|SH_UNDER_POST;/*底下中间有一截碰撞箱（盖住墙柱子那块）：底面中心支撑*/
	static const uint32_t base_full=sh_Full(NB_D)|SH_SOLID;/*不到一格高、底是平的：只有底面整面*/
	static const uint32_t clear_cube=SH_CUBE&~SH_RENDER;/*完整方块但不是整块不透明（蘑菇不能长）*/
	static const uint32_t soft_cube=(SH_CUBE&~SH_TOPCOLL&~(0x3Fu<<SH_COLL0))|sh_Coll(NB_D);/*支撑形状整格、碰撞箱矮 2 像素（灵魂沙/泥巴）*/
	struct Nm{const char *pat;uint32_t sh;};
	static const Nm nms[]={
		{"*_leaves",SH_SOLID|SH_TOPCOLL|(0x3Fu<<SH_COLL0)},/*支撑形状是空的（火把等放不上），碰撞箱是满的（藤蔓/地衣能贴、能积雪、海泡菜能放），legacy solid*/
		{"cactus",foot|SH_SOLID},/*碰撞箱 14×15×14：顶面/侧面都碰不到格子边*/
		{"honey_block",foot|SH_SOLID},
		{"azalea",sh_Full(NB_U)|foot|SH_TOPCOLL},/*forceSolidOff：告示牌/旗帜/蛋糕不行；侧面什么都贴不上*/
		{"flowering_azalea",sh_Full(NB_U)|foot|SH_TOPCOLL},
		{"chorus_flower",sh_Center(NB_D)|(0x3Fu<<SH_COLL0)|SH_TOPCOLL},/*支撑形状是 14×15×14 的柱子（只有底面中心），
		   碰撞箱整格（藤蔓/地衣能贴、能积雪）；强制不实心*/
		{"scaffolding",sh_Full(NB_U)|SH_TOPCOLL},/*只有顶面；侧面、底下什么都不能贴；不实心，也不是整块不透明（蘑菇不能长）*/
		{"cauldron",SH_RIGID_UP|SH_SOLID|SH_TOPCOLL},/*顶面只有一圈边；底下有脚*/
		{"water_cauldron",SH_RIGID_UP|SH_SOLID|SH_TOPCOLL},
		{"lava_cauldron",SH_RIGID_UP|SH_SOLID|SH_TOPCOLL},
		{"powder_snow_cauldron",SH_RIGID_UP|SH_SOLID|SH_TOPCOLL},
		{"composter",SH_RIGID_UP|sh_Full(NB_D)|sh_Full(NB_E)|sh_Full(NB_W)|sh_Full(NB_S)|sh_Full(NB_N)|SH_SOLID|SH_TOPCOLL},
		{"brewing_stand",foot|SH_SOLID},
		{"sculk_sensor",base_full},{"calibrated_sculk_sensor",base_full},{"sculk_shrieker",base_full},
		{"heavy_core",foot},/*底座比格子窄：只有底面中心，不实心*/
		{"enchanting_table",base_full},{"lectern",base_full},{"stonecutter",base_full},{"campfire",base_full},
		{"soul_campfire",base_full},{"daylight_detector",base_full},{"farmland",base_full},{"dirt_path",base_full},
		{"repeater",sh_Full(NB_D)},{"comparator",sh_Full(NB_D)},/*2 像素的板：底面整面（下面能挂灯笼/藤蔓），不实心*/
		{"*_carpet",sh_Full(NB_D)},{"moss_carpet",sh_Full(NB_D)},
		{"decorated_pot",pads},{"dragon_egg",pads},{"sniffer_egg",pads},
		{"anvil",pads},{"chipped_anvil",pads},{"damaged_anvil",pads},
		{"turtle_egg",foot|SH_SOLID},/*底面中心（能挂灯笼）；强制实心*/
		{"candle_cake",foot|SH_SOLID},{"*_candle_cake",foot|SH_SOLID},
		{"candle",foot},{"*_candle",foot},{"sea_pickle",foot},{"lily_pad",foot},
		{"copper_golem_statue",foot},{"*_copper_golem_statue",foot},{"dried_ghast",foot|SH_SOLID},
		{"flower_pot",foot},{"potted_*",foot},
		{"*_wall_skull",0},{"*_wall_head",0},
		{"skeleton_skull",foot},{"wither_skeleton_skull",foot},{"zombie_head",foot},
		{"player_head",foot},{"creeper_head",foot},{"dragon_head",foot},
		{"piglin_head",foot},
		{"conduit",SH_SOLID},/*悬空的小球，哪一面都不碰格子边；强制实心*/
		{"*_sign",SH_SOLID},{"*_banner",SH_SOLID},/*forceSolidOn：告示牌上还能放告示牌*/
		{"bamboo",SH_SOLID|SH_TOPCOLL},{"cobweb",SH_SOLID},{"straw_bed",sh_Full(NB_D)|SH_SOLID},{"*_bed",SH_SOLID},
		{"big_dripleaf",0},/*大垂滴叶强制不实心；叶子碰撞箱顶在 15/16，顶面不算*/
		{"moving_piston",SH_SOLID},/*正在推的那格：形状靠方块实体，没有就是空的*/
		/*强制实心的薄片：没有能贴的面，但告示牌/旗帜/蛋糕能放、仙人掌挨着会碎*/
		{"bamboo_sapling",SH_SOLID},
		{"dead_*_coral",SH_SOLID},{"dead_*_coral_fan",SH_SOLID},{"dead_*_coral_wall_fan",SH_SOLID},
		{"*_pressure_plate",SH_SOLID},{"sculk_vein",SH_SOLID},
		{"soul_sand",soft_cube},{"mud",soft_cube},
		{"ice",clear_cube},{"frosted_ice",clear_cube},{"barrier",clear_cube},{"*glass",clear_cube},
		{"slime_block",clear_cube},{"beacon",clear_cube},{"spawner",clear_cube},{"trial_spawner",clear_cube},
		{"vault",clear_cube},{"mangrove_roots",clear_cube},{"*copper_grate",clear_cube},{"test_instance_block",clear_cube},
		{"shulker_box",clear_cube},{"*_shulker_box",clear_cube},
	};
	for(size_t i=0;i<sizeof(nms)/sizeof(nms[0]);i++){
		if(match_Pattern(nms[i].pat,n)){
			return nms[i].sh;
		}
	}
	if(lev==S_THIN){
		return 0;/*薄片：没有支撑面、碰撞面，也不是 legacy solid（例外都在上面的表里）*/
	}
	if(lev==S_PART){
		return posts;/*其余“有形状的”：只当上下中心支撑（宁可漏拆）*/
	}
	return SH_CUBE;
}
static int get_Clockwise(int d){/*水平方向顺时针转90°（从上往下看）：北→东→南→西*/
	switch(d){
	case NB_N:return NB_E;
	case NB_E:return NB_S;
	case NB_S:return NB_W;
	case NB_W:return NB_N;
	default:return -1;
	}
}
static int get_CounterClockwise(int d){/*逆时针：北→西→南→东*/
	int c=get_Clockwise(d);
	return c<0?-1:get_OppositeDir(c);
}
static bool is_Horizontal(int d){/*东西南北四个方向之一（-1 和上下都不是）*/
	return d==NB_E||d==NB_W||d==NB_S||d==NB_N;
}
static uint32_t calc_StateShape(uint8_t sp,const Blk_Info *b){/*要看属性的形状（b 的 name/props 已经由主机填好）*/
	int f=get_DirIndex(get_Prop(b,"facing"));
	uint32_t s=0;
	switch(sp){
	case SP_SLAB:
		if(is_PropValue(b,"type","double")){
			return SH_CUBE;
		}
		return is_PropValue(b,"type","top")?sh_Full(NB_U)|SH_SOLID|SH_TOPCOLL:sh_Full(NB_D)|SH_SOLID;
	case SP_STAIRS:/*上半/下半那一面整面；直的背面（facing）整面；内角再加左边（inner_left，facing 逆时针）或右边一面；外角没有*/
		s=SH_SOLID|SH_TOPCOLL|(is_PropValue(b,"half","top")?sh_Full(NB_U):sh_Full(NB_D));
		if(is_Horizontal(f)){
			const char *sh=get_Prop(b,"shape");
			if(!sh||!strcmp(sh,"straight")){
				s|=sh_Full(f);
			}else if(!strcmp(sh,"inner_left")){
				s|=sh_Full(f)|sh_Full(get_CounterClockwise(f));
			}else if(!strcmp(sh,"inner_right")){
				s|=sh_Full(f)|sh_Full(get_Clockwise(f));
			}
		}
		return s;
	case SP_TRAPDOOR:/*开着：竖起来的板贴在 facing 的反面；关着：上半给顶面、下半给底面*/
		if(is_PropValue(b,"open","true")){
			return SH_SOLID|SH_TOPCOLL|(is_Horizontal(f)?sh_Full(get_OppositeDir(f)):0);
		}
		return SH_SOLID|(is_PropValue(b,"half","top")?sh_Full(NB_U)|SH_TOPCOLL:sh_Full(NB_D));
	case SP_DOOR:/*关着：门板在 facing 的反面；开着：左铰链转到 facing 逆时针那面，右铰链转到顺时针那面（上下两半一样）*/
		s=SH_SOLID|SH_TOPCOLL;
		if(is_Horizontal(f)){
			if(!is_PropValue(b,"open","true")){
				s|=sh_Full(get_OppositeDir(f));
			}else{
				s|=sh_Full(is_PropValue(b,"hinge","right")?get_Clockwise(f):get_CounterClockwise(f));
			}
		}
		return s;
	case SP_FENCE_GATE:/*底下没有支撑形状（从 5 像素起）；顶上中心；开着没有支撑形状，但强制实心。
	                     关着的碰撞箱是门板那一条（24 高、贴地）：盖住墙的柱子和门板方向的两条臂*/
		if(is_PropValue(b,"open","true")){
			return SH_SOLID;
		}
		s=sh_Center(NB_U)|SH_SOLID|SH_TOPCOLL|SH_UNDER_POST;
		if(is_Horizontal(f)){
			s|=sh_Under(get_Clockwise(f))|sh_Under(get_CounterClockwise(f));
		}
		return s;
	case SP_FENCE:{/*栅栏/玻璃板/铁栏杆：上下中心支撑；碰撞箱贴地：柱子盖住墙的柱子那块，连着的那几边的臂盖住那几条臂*/
		static const char *sides[]={"east","west","south","north"};
		static const int dirs[]={NB_E,NB_W,NB_S,NB_N};
		s=sh_Center(NB_U)|sh_Center(NB_D)|SH_SOLID|SH_TOPCOLL|SH_UNDER_POST;
		for(int i=0;i<4;i++){
			if(is_PropValue(b,sides[i],"true")){
				s|=sh_Under(dirs[i]);
			}
		}
		return s;
	}
	case SP_CHEST:{/*箱子/陷阱箱/末影箱/铜箱子：14 高，只有底面中心；大箱子朝另一半那边伸到格子边
	                 （ChestBlock.getConnectedDirection：left 在 facing 顺时针那边，right 在逆时针那边）*/
		s=sh_Center(NB_D)|SH_SOLID|SH_UNDER_POST;
		if(is_Horizontal(f)){
			if(is_PropValue(b,"type","left")){
				s|=sh_Under(get_Clockwise(f));
			}else if(is_PropValue(b,"type","right")){
				s|=sh_Under(get_CounterClockwise(f));
			}
		}
		return s;
	}
	case SP_SNOW:{/*支撑形状=layers 层高的板；碰撞箱比它矮一层（1层没有碰撞箱）；8层整格但碰撞箱顶面不满；forceSolidOff*/
		const char *ly=get_Prop(b,"layers");
		if(ly&&!strcmp(ly,"8")){
			return (SH_CUBE&~SH_SOLID&~SH_TOPCOLL&~(0x3Fu<<SH_COLL0))|sh_Coll(NB_D);
		}
		if(!ly||!strcmp(ly,"1")){
			return sh_Full(NB_D)&~sh_Coll(NB_D);
		}
		return sh_Full(NB_D);
	}
	case SP_CHORUS_PLANT:/*down=true 底面中间有一截、up=true 顶面中间有一截：中心支撑；侧面什么都不能贴*/
		return (is_PropValue(b,"down","true")?sh_Center(NB_D)|SH_UNDER_POST:0)|(is_PropValue(b,"up","true")?sh_Center(NB_U)|SH_TOPCOLL:0);
	case SP_ROD:
	case SP_LIGHTNING_ROD:/*细杆：沿杆的两个端面给中心支撑。避雷针强制实心；末地烛不实心*/
		if(f<0){
			f=NB_U;
		}
		s=sp==SP_LIGHTNING_ROD?SH_SOLID:0;
		s|=sh_Center(f)|sh_Center(get_OppositeDir(f));
		if(f==NB_U||f==NB_D){
			s|=SH_TOPCOLL|SH_UNDER_POST;
		}
		return s;
	case SP_CHAIN:{
		const char *ax=get_Prop(b,"axis");
		if(!ax||!strcmp(ax,"y")){
			return sh_Center(NB_U)|sh_Center(NB_D)|SH_SOLID|SH_TOPCOLL|SH_UNDER_POST;
		}
		return SH_SOLID|(!strcmp(ax,"x")?sh_Center(NB_E)|sh_Center(NB_W):sh_Center(NB_S)|sh_Center(NB_N));/*锁链强制实心，横着也是*/
	}
	case SP_HOPPER:/*顶面一圈边；漏嘴朝下时底面中心*/
		return SH_RIGID_UP|SH_SOLID|SH_TOPCOLL|(is_PropValue(b,"facing","down")?sh_Center(NB_D)|SH_UNDER_POST:0);
	case SP_GRINDSTONE:
		if(is_PropValue(b,"face","floor")){
			return sh_Center(NB_U)|SH_SOLID|SH_TOPCOLL;
		}
		return is_PropValue(b,"face","ceiling")?sh_Center(NB_D)|SH_SOLID|SH_TOPCOLL|SH_UNDER_POST:SH_SOLID;/*吊着的砂轮两条腿往上、
		  轮子贴着底：盖住墙的柱子那块；落地的两条腿在两边，盖不住*/
	case SP_EPF:/*13 高，底面整面；装了眼的那颗眼给顶面中心*/
		return sh_Full(NB_D)|SH_SOLID|(is_PropValue(b,"eye","true")?sh_Center(NB_U)|SH_TOPCOLL:0);
	case SP_BELL:/*落地：上下中心，底座是横着的一条（盖住墙的柱子和 facing 垂直方向的两条臂）；吊顶：顶上那截横梁给顶面中心；
	               贴墙：哪面都不碰格子边*/
		if(is_PropValue(b,"attachment","floor")){
			s=sh_Center(NB_U)|sh_Center(NB_D)|SH_SOLID|SH_TOPCOLL|SH_UNDER_POST;
			if(is_Horizontal(f)){
				s|=sh_Under(get_Clockwise(f))|sh_Under(get_CounterClockwise(f));
			}
			return s;
		}
		return SH_SOLID|(is_PropValue(b,"attachment","ceiling")?sh_Center(NB_U)|SH_TOPCOLL:0);
	case SP_LADDER:/*3 像素的板贴在 facing 的反面：那一面整面（两架梯子背靠背能互相撑住）*/
		return SH_TOPCOLL|(is_Horizontal(f)?sh_Full(get_OppositeDir(f)):0);
	case SP_AMETHYST:/*紫水晶簇/芽：底座那一面中心支撑（朝上的给底面，朝下的给顶面）；强制实心*/
		if(f==NB_U){
			return sh_Center(NB_D)|SH_SOLID|SH_UNDER_POST;
		}
		return SH_SOLID|(f==NB_D?sh_Center(NB_U)|SH_TOPCOLL:0);
	case SP_DRIP:{/*滴水石锥：尖端那头碰不到格子边，另一头（和中间各节的两头）给中心支撑；强制实心*/
		bool up=is_PropValue(b,"vertical_direction","up");
		if(is_PropValue(b,"thickness","tip")){
			return SH_SOLID|(up?sh_Center(NB_D):sh_Center(NB_U)|SH_TOPCOLL);
		}
		return sh_Center(NB_D)|sh_Center(NB_U)|SH_SOLID|SH_TOPCOLL;
	}
	case SP_LANTERN:/*放在地上的灯笼底面中心（下面还能挂灯笼）；挂着的碰不到格子边；强制实心*/
		return SH_SOLID|(is_PropValue(b,"hanging","true")?0:sh_Center(NB_D)|SH_UNDER_POST);
	case SP_CAKE:{/*吃掉 4 块以上，剩下那块盖不住底面中心*/
		const char *bt=get_Prop(b,"bites");
		return SH_SOLID|(bt&&bt[0]>='4'&&bt[0]<='6'&&!bt[1]?0:sh_Center(NB_D)|SH_UNDER_POST);
	}
	case SP_PITCHER:/*瓶子草作物：下半有个底座（底面中心），上半没有碰撞箱*/
		return is_PropValue(b,"half","lower")?sh_Center(NB_D)|SH_UNDER_POST:0;
	case SP_PISTON:/*收着的是整方块；伸出去的底座只剩 12 像素：背面整面，横着的上下两面给中心；朝上推的顶面空了；
	                 横着推的底面只缺推的那一边（墙朝那边的臂盖不住）*/
		if(!is_PropValue(b,"extended","true")){
			return SH_CUBE;
		}
		if(f<0){
			return SH_SOLID;
		}
		return sh_Full(get_OppositeDir(f))|SH_SOLID|(is_Horizontal(f)?sh_Center(NB_U)|sh_Center(NB_D)|(SH_UNDER_ALL&~sh_Under(f)):0)|
			(f!=NB_U?SH_TOPCOLL:0);
	case SP_PISTON_HEAD:/*推杆头：facing 那面整面；竖着的推杆从另一头穿出来（中心支撑）*/
		if(f<0){
			return SH_SOLID;
		}
		return sh_Full(f)|SH_SOLID|SH_TOPCOLL|(f==NB_U?sh_Center(NB_D)|SH_UNDER_POST:f==NB_D?sh_Center(NB_U):0);
	case SP_SHELF:/*展示架：背板贴在 facing 的反面（那一面整面）*/
		return SH_SOLID|SH_TOPCOLL|(is_Horizontal(f)?sh_Full(get_OppositeDir(f)):0);
	case SP_WALL:{/*墙：有柱子或者有任一侧连接就有上下中心（碰撞箱 24 高，中间那截一定在）；
	                四边都不连又没柱子的空状态什么都没有。墙都强制实心（26.1.1 的树脂砖墙除外，26.3 起也是）。
	                碰撞箱贴地：有东西就盖住上一格墙的柱子那块，连着的那几边（low/tall 一样）盖住那几条臂*/
		static const char *sides[]={"east","west","north","south"};
		static const int dirs[]={NB_E,NB_W,NB_N,NB_S};
		bool any=!is_PropValue(b,"up","false");
		uint32_t arms=0;
		for(int i=0;i<4;i++){
			const char *v=get_Prop(b,sides[i]);
			if(v&&strcmp(v,"none")){
				any=true;
				arms|=sh_Under(dirs[i]);
			}
		}
		if(any){
			return sh_Center(NB_U)|sh_Center(NB_D)|SH_SOLID|SH_TOPCOLL|SH_UNDER_POST|arms;
		}
		return SH_SOLID;/*26.3 起树脂砖墙也强制实心*/
	}
	case SP_HSIGN:/*墙上吊牌：上下中心；天花板吊牌：底面中心，斜着挂（rotation 不是 4 的倍数）的才连到顶面中心；吊牌没有碰撞箱*/
		if(has_Suffix(b->base,"_wall_hanging_sign")){
			return sh_Center(NB_U)|sh_Center(NB_D)|SH_SOLID|SH_TOPCOLL;
		}else{
			const char *r=get_Prop(b,"rotation");
			int rv=r?atoi(r):0;
			return sh_Center(NB_D)|SH_SOLID|(rv%4?sh_Center(NB_U):0);
		}
	case SP_PALE_CARPET:/*苍白苔藓地毯：铺在地上的（bottom=true）底面整面；只剩侧面垂下来的那种什么都没有*/
		return is_PropValue(b,"bottom","false")?0:sh_Full(NB_D);
	default:
		return 0;
	}
}

struct Name_Info{          /*只跟名字有关的那部分：同一个名字（各种属性、各个区块）共用一份*/
	std::string_view base; /*冒号后面那段*/
	uint8_t lev;           /*支撑档 S_* */
	uint8_t nflags;        /*B_*（只有跟名字有关的那些位）*/
	uint8_t special;       /*SP_*：形状要看属性的那几类*/
	uint8_t mflags;        /*PF_REPLACE/PF_LIQUID/PF_BURN 里和名字有关的那几位（PF_BURN 还要看含水）*/
	int16_t def;           /*defs下标，-1=不管（mod方块也是-1）*/
	uint32_t set_mask;     /*命中哪几个支持集（位对应set_List下标）*/
	uint32_t shape;        /*special==SP_NONE 时的形状位图*/
	uint8_t lflags;        /*CK_*：栅栏/墙连接要认的类别（只有原版方块有）*/
	uint8_t instr;         /*音符盒音色（只有原版方块有，模组方块当 harp；用的时候先看 is_Vanilla）*/
	const nbt_Compound *defaults;/*默认状态的属性（只有原版、带属性的方块有；指在 defaults_Pool 里），NULL＝没有*/
	bool leafkeep;         /*#prevents_nearby_leaf_decay*/
};
/*名字池：hash表的key指在池子里那份字符串上（NBT里的字符串活不过区块缓存，不能拿来当key）*/
static std::deque<std::string> name_Pool;
static std::deque<nbt_Compound> defaults_Pool;/*每种方块的默认属性（Name_Info.defaults 指在这里）*/
static std::unordered_map<std::string,nbt_Compound> full_Props;/*补全过默认值的属性：键是“名字|写出来的属性”，同一种写法只存一份*/
/*新格式（26.3 快照 7 起）没写的属性取默认值（StateHolder.codec / StateDefinition.appendPropertyCodec）：
  调色板条目里少了哪个属性，就把默认值补上，Blk_Info.props 换成指向补全以后的那份（在 full_Props 里，reset_Rules 之前一直有效）。
  规则看到的、交回去写的都是写全了的状态；写回存档时游戏照样认。属性都写全了（26.1.1 的存档）就不动 props*/
static void fill_Defaults(Blk_Info *o,const nbt_Compound *def){
	if(!def){
		return;
	}
	bool full=o->props!=NULL;
	for(auto it=def->con.begin();full&&it!=def->con.end();++it){
		if(!o->props->get(it->first)){
			full=false;
		}
	}
	if(full){
		return;
	}
	std::vector<std::string> kv;
	if(o->props){
		for(auto it=o->props->con.begin();it!=o->props->con.end();++it){
			kv.push_back(it->first+"="+std::string(it->second->as_String().value_or("?")));
		}
	}
	std::sort(kv.begin(),kv.end());
	std::string key(o->name);
	key+='|';
	for(const std::string &e:kv){
		key+=e+',';
	}
	auto f=full_Props.find(key);
	if(f==full_Props.end()){
		nbt_Compound c=*def;
		if(o->props){
			for(auto it=o->props->con.begin();it!=o->props->con.end();++it){
				nbt_Any *v=it->second->copy();
				c.set(it->first,v);
			}
		}
		f=full_Props.emplace(key,std::move(c)).first;
	}
	o->props=&f->second;
}
static std::unordered_map<std::string_view,Name_Info> name_Map;
static const Name_Info &get_NameInfo(std::string_view nm){/*方块全名 → 只跟名字有关的那份分类；第一次见到这个名字时算好存起来，以后直接查*/
	std::unordered_map<std::string_view,Name_Info>::iterator it=name_Map.find(nm);
	if(it!=name_Map.end()){
		return it->second;
	}
	name_Pool.push_back(std::string(nm));
	std::string_view own(name_Pool.back());
	std::string_view n=strip_Spacename(own);
	Name_Info ni;
	ni.base=n;
	unsigned f=0;
	size_t p=own.find(':');
	if(p==std::string_view::npos||own.substr(0,p)=="minecraft"){
		f|=B_MC;
	}
	if(is_AirName(n)){
		f|=B_AIR;
	}
	if(n=="magma_block"){
		f|=B_MAGMA;
	}
	if(n=="water"||n=="bubble_column"||n=="kelp"||n=="kelp_plant"||n=="seagrass"||
	   n=="tall_seagrass"){
		f|=B_WATER_NAME;/*只有名字本身就是水/水草的才无条件算水；珊瑚/海泡菜靠waterlogged属性*/
	}
	if(has_Suffix(n,"_slab")){
		f|=B_SLAB;
	}
	ni.lev=(uint8_t)get_NameSupport(n);
	ni.shape=calc_NameShape(n,ni.lev,&ni.special);
	ni.nflags=(uint8_t)f;
	unsigned mf=0;
	if(f&B_MC){/*材质表只登记了原版方块*/
		if(is_NameIn(set_replace,n)){
			mf|=PF_REPLACE;
		}
		if(is_NameIn(set_liquid,n)){
			mf|=PF_LIQUID;
		}
		if(is_NameIn(set_burn,n)){
			mf|=PF_BURN;
		}
	}
	ni.mflags=(uint8_t)mf;
	ni.lflags=(uint8_t)((f&B_MC)?get_NameLink(n):0);
	ni.instr=0;
	ni.leafkeep=false;
	ni.defaults=NULL;
	if(f&B_MC){
		init_GenTables();
		init_Defaults();
		auto di=defaults_Map.find(n);
		if(di!=defaults_Map.end()){
			nbt_Compound &dc=defaults_Pool.emplace_back();
			std::string_view a=di->second;
			while(!a.empty()){
				size_t cm=a.find(',');
				std::string_view kv=a.substr(0,cm);
				size_t eq=kv.find('=');
				if(eq!=std::string_view::npos){
					dc.set_String(std::string(kv.substr(0,eq)),std::string(kv.substr(eq+1)));
				}
				if(cm==std::string_view::npos){
					break;
				}
				a=a.substr(cm+1);
			}
			ni.defaults=&dc;
		}
		auto ii=instr_Map.find(n);
		if(ii!=instr_Map.end()){
			ni.instr=ii->second;
		}
		ni.leafkeep=leafkeep_Map.count(n)!=0;
	}
	ni.def=(f&B_MC)?(int16_t)find_Def(n):-1;
	uint32_t m=0;
	for(int j=0;j<SET_CNT;j++){
		for(int k=0;set_List[j][k];k++){
			if(match_Pattern(set_List[j][k],n)){
				m|=1u<<j;
				break;
			}
		}
	}
	ni.set_mask=m;
	return name_Map.emplace(std::string_view(name_Pool.back()),ni).first->second;
}
static void fill_Info(Blk_Info *o){/*一个调色板条目只算一次；主机已经填好 blk/name/props*/
	const Name_Info &ni=get_NameInfo(o->name);
	fill_Defaults(o,ni.defaults);/*先补默认属性：下面看属性的都看补全以后的*/
	unsigned lev=ni.lev,f=0,k=0;
	if(ni.nflags&B_AIR){
		f|=BF_AIR;
	}
	if(ni.nflags&B_MAGMA){
		k|=PF_MAGMA;
	}
	k|=ni.mflags&(PF_REPLACE|PF_LIQUID);
	if((ni.mflags&PF_BURN)&&!is_PropValue(o,"waterlogged","true")){
		k|=PF_BURN;/*FireBlock.getIgniteOdds：含水的一律 0*/
	}
	if((ni.nflags&B_SLAB)&&is_PropValue(o,"type","double")){
		lev=S_FULL;/*双台阶就是整方块*/
	}
	if(ni.base=="snow"&&is_PropValue(o,"layers","8")){
		lev=S_FULL;/*8层雪就是整方块：SnowLayerBlock.getBlockSupportShape=SHAPES[layers]，
		             8层那格顶面是满的，原版上面能放火把/铁轨/红石/门，雪也能叠上去（layers<8才只算薄片）*/
	}
	if((ni.nflags&B_WATER_NAME)||is_PropValue(o,"waterlogged","true")){
		f|=BF_WATER;/*名字就是水/水草海带，或者含水（甘蔗、海带旁边认这个）*/
	}
	if(ni.base=="water"){
		const char *lv=get_Prop(o,"level");
		if(!lv||!strcmp(lv,"0")){
			k|=PF_WATER_SRC;/*水源（流动水不算）*/
		}
	}else if(f&BF_WATER){
		k|=PF_WATER_SRC;/*含水方块、水草海带里面的水也是水源（wiki青蛙卵：含水方块上也能放）*/
	}
	o->base=ni.base;
	o->flags=(uint8_t)f;
	uint32_t sh=ni.special?calc_StateShape(ni.special,o):ni.shape;
	if(sh&sh_Coll(NB_D)){
		sh|=SH_UNDER_ALL;/*碰撞箱底面整面：墙的五块测试区都盖住*/
	}
	o->priv[P_SHAPE]=sh;
	o->priv[P_SETS]=ni.set_mask;
	o->priv[P_DEF]=(uint32_t)(ni.def+1);
	o->priv[P_MISC]=lev|(k<<8)|((uint32_t)ni.lflags<<16)|((uint32_t)ni.instr<<24)|((uint32_t)ni.leafkeep<<29);
}

/*---- 支持/形状的小判断（规则函数用）：都查形状位图（get_Shape），见“按面的支撑位图” ----*/
static bool is_WaterSource(const Blk_Info *b){return b&&has_Kind(b,PF_WATER_SRC);}/*这格的流体是水源（含水方块也算）*/
static bool is_SameBase(const Blk_Info *a,const Blk_Info *b){/*同一种方块（不比属性，原版 is(this) 就是这个意思）*/
	return a&&b&&!a->base.empty()&&a->base==b->base;
}
static bool is_FaceFull(const Blk_Info *b,int dir){/*b 的 dir 面是不是整面（SupportType.FULL）*/
	return b&&dir>=0&&dir<6&&(get_Shape(b)&(1u<<dir));
}
static bool is_FaceCenter(const Blk_Info *b,int dir){/*b 的 dir 面够不够中心支撑（SupportType.CENTER）*/
	return b&&dir>=0&&dir<6&&(get_Shape(b)&sh_Center(dir));
}
static bool is_Rim(const Blk_Info *b){/*顶面带边（SupportType.RIGID）：整方块/上半砖/倒楼梯/上半活板门/漏斗/堆肥桶/炼药锅*/
	return b&&(get_Shape(b)&SH_RIGID_UP);
}
static bool is_Solid(const Blk_Info *b){/*legacy isSolid（告示牌/旗帜/蛋糕、仙人掌旁边）*/
	return b&&(get_Shape(b)&SH_SOLID);
}
static bool can_FaceAttach(const Blk_Info *b,int dir){/*MultifaceBlock.canAttachTo：b 的 dir 面支撑面整面或碰撞面整面
	（藤蔓/发光地衣/幽匿脉络/树脂团；树叶的支撑面是空的但碰撞面满，所以能贴）*/
	return b&&dir>=0&&dir<6&&(get_Shape(b)&((1u<<dir)|sh_Coll(dir)));
}
static bool check_Support(const Fix_Def &d,const Blk_Info *b,int dir){/*b 的 dir 面够不够格当支持*/
	if(!b){
		return false;
	}
	if(d.set&&(get_Sets(b)&d.set_bit)){
		return true;/*支持集是标签（#supports_vegetation 这种）或 wiki 点名的例外（红石线的漏斗）：整块比名字，不分方向*/
	}
	if(d.flags&F_ISSOLID){
		return is_Solid(b);/*告示牌/旗帜/蛋糕：原版 isSolid()，整块判，不分方向*/
	}
	if(!d.lev){
		return false;
	}
	if(d.lev==S_THIN){
		return get_Lev(b)>=S_THIN;/*“只要有东西”*/
	}
	if(d.flags&F_SOLID){
		return is_FaceFull(b,dir)&&(get_Shape(b)&SH_RENDER);/*蘑菇：顶面完整且整块不透明（isSolidRender）*/
	}
	if(d.lev>=S_FULL){
		return is_FaceFull(b,dir)||((d.flags&F_COLL)&&(get_Shape(b)&sh_Coll(dir)));
	}
	return is_FaceCenter(b,dir)||((d.flags&F_RIGID)&&dir==NB_U&&is_Rim(b));
}
static bool is_InSet(const char *const *set,const Blk_Info *b){/*b的basename在不在这个集合里（给几个特判用）*/
	if(!b||!set){
		return false;
	}
	for(int i=0;set[i];i++){
		if(match_Pattern(set[i],b->base)){
			return true;
		}
	}
	return false;
}

/*==================== 5. 判一条规则 ====================*/
static int get_OppositeDir(int dir){/*反方向的下标（dir 从 A 指向 B，对面就是 B 指向 A）*/
	static const int o[6]={NB_W,NB_E,NB_D,NB_U,NB_N,NB_S};
	return dir>=0&&dir<6?o[dir]:-1;
}
static int get_DirIndex(const char *dir){/*方向名→NB_* 下标；不认识给-1*/
	if(!dir){
		return -1;
	}
	if(!strcmp(dir,"east")){
		return NB_E;
	}
	if(!strcmp(dir,"west")){
		return NB_W;
	}
	if(!strcmp(dir,"up")){
		return NB_U;
	}
	if(!strcmp(dir,"down")){
		return NB_D;
	}
	if(!strcmp(dir,"south")){
		return NB_S;
	}
	if(!strcmp(dir,"north")){
		return NB_N;
	}
	return -1;
}
static const int nb_h[4]={NB_E,NB_W,NB_S,NB_N};/*四个水平方向*/
static const Blk_Info *get_Neighbor(Rules_Ctx &c,int dir){/*只看fixer填好的六格；没填/读不出来就作废这格*/
	if(dir<0||dir>5){
		return NULL;
	}
	if(!(c.got&(1<<dir))||(c.bad&(1<<dir))){
		c.blind=true;
		return NULL;
	}
	return c.nb[dir];
}
static const Blk_Info *get_NeighborAt(Rules_Ctx &c,const char *dir){/*按方向名（facing那种）取邻居；不认识的方向给NULL*/
	int d=get_DirIndex(dir);
	return d<0?NULL:get_Neighbor(c,d);
}
static const Blk_Info *get_OppositeNeighbor(Rules_Ctx &c,const char *dir){/*反方向的邻居（facing指哪边，支撑就在对面）*/
	int d=get_DirIndex(dir);
	return d<0?NULL:get_Neighbor(c,get_OppositeDir(d));
}
static bool is_TouchingWater(Rules_Ctx &c){/*混凝土粉末碰到水（ConcretePowderBlock.touchesLiquid）：
	上面和四个侧面里凡是"含水的"（水方块、含水方块、水草海带…），只要它朝我们这一面不是满的，水就能碰到粉末 → 凝固。
	满面的含水方块（比如泡水的楼梯那半面）水碰不过来，不算。**正下方不算**：原版循环里向下那一次只在粉末自己含水时才看
	（粉末不会含水），所以坐在水面上的粉末不凝固*/
	static const int dirs[5]={NB_U,NB_E,NB_W,NB_S,NB_N};
	for(int i=0;i<5;i++){
		const Blk_Info *n=get_Neighbor(c,dirs[i]);
		if(!n){
			continue;/*读不出来：blind已经置上，这一格结论作废*/
		}
		bool wet=(n->base=="water")||(n->flags&BF_WATER);
		if(wet&&!is_FaceFull(n,get_OppositeDir(dirs[i]))){
			return true;
		}
	}
	return false;
}
static int set_OutBlock(Rules_Ctx &c,Block b,bool keep){/*新状态交给主机按区块的格式写*/
	c.out_block=std::move(b);
	c.out_keep_be=keep;
	return FX_SET;
}
static Block copy_State(const Blk_Info *b){/*这一格的方块状态（名字+写出来的属性），拿来改*/
	Block o{nbt_String(std::string(b->name))};
	if(b->props){
		o.properties=*b->props;
	}
	return o;
}
static Block edit_State(const Blk_Info *self,const char *const *keys,const char *const *vals,int n){/*复制一份把属性改掉（藤蔓关面用）*/
	Block o=copy_State(self);
	for(int i=0;i<n;i++){
		o.properties.set_String(keys[i],vals[i]);
	}
	return o;
}
static int judge_Below(const Fix_Def &d,Rules_Ctx &c){/*下面要有支持（最常见的一条）；支撑块朝上那一面（NB_U）*/
	const Blk_Info *b=get_Neighbor(c,NB_D);
	bool self_ok=(d.flags&F_SELF)&&is_SameBase(b,c.self);
	bool ok=check_Support(d,b,NB_U)||self_ok;
	if(!ok&&(d.flags&F_NONAIR)){/*只要不是空气（水也算）：地毯*/
		ok=b&&!is_Air(b);
	}
	if(!ok&&(d.flags&F_TOPCOLL)){/*海泡菜：顶面有碰撞箱或顶面整面*/
		ok=b&&((get_Shape(b)&SH_TOPCOLL)||is_FaceFull(b,NB_U));
	}
	if(!ok&&(d.flags&F_WET_D)){/*睡莲/青蛙卵：下面的流体是水源*/
		ok=is_WaterSource(b);
	}
	if(!ok){
		return FX_AIR;
	}
	if(d.flags&F_NOSIDE){/*仙人掌（Wiki Cactus §Usage）：四周有 legacy solid 的方块或岩浆就碎，上面是水/岩浆也碎。
	                        这条要先查，叠同类也不能免；8层雪/花这些不是 solid，不算*/
		for(int i=0;i<4;i++){
			const Blk_Info *s=get_Neighbor(c,nb_h[i]);
			if(s&&(is_Solid(s)||s->base=="lava")){
				return FX_AIR;
			}
		}
		const Blk_Info *u=get_Neighbor(c,NB_U);
		if(u&&has_Kind(u,PF_LIQUID)){/*上面是流体方块（BlockState.liquid：水/岩浆/气泡柱）*/
			return FX_AIR;
		}
	}
	if(d.flags&F_ABOVE_KEY){/*上面还得是自己或者 key（大型垂滴叶茎）*/
		const Blk_Info *u=get_Neighbor(c,NB_U);
		if(!u||!(is_SameBase(u,c.self)||(d.key&&u->base==d.key))){
			return FX_AIR;
		}
	}
	if(self_ok){
		return FX_KEEP;/*下面就是同类（竹子叠竹子/海带叠海带）：原版直接算数，不用再查别的*/
	}
	if((d.flags&F_NO_MAGMA)&&b&&has_Kind(b,PF_MAGMA)){
		return FX_AIR;
	}
	if((d.flags&F_WATER)&&!(c.self->flags&BF_WATER)){/*自己不是水里的方块（海草/海带/气泡柱本身都含水）*/
		return FX_AIR;
	}
	return FX_KEEP;
}
static int judge_2X(const Fix_Def &d,Rules_Ctx &c){/*两格高：上下半截互查*/
	const char *half=get_Prop(c.self,"half");
	if(!half){
		return FX_KEEP;/*没有half属性就当普通方块，不动它*/
	}
	if(!strcmp(half,"upper")){
		const Blk_Info *b=get_Neighbor(c,NB_D);
		if(!is_SameBase(b,c.self)||!is_PropValue(b,"half","lower")){
			return FX_AIR;
		}
		return FX_KEEP;
	}
	const char *age=c.self->base=="pitcher_crop"?get_Prop(c.self,"age"):NULL;
	bool single=age&&age[0]>='0'&&age[0]<='2'&&!age[1];/*瓶子草作物 age 0~2 只有下半格（PitcherCropBlock.isDouble：age>=3）*/
	if(!single){
		const Blk_Info *u=get_Neighbor(c,NB_U);
		if(!is_SameBase(u,c.self)||!is_PropValue(u,"half","upper")){
			return FX_AIR;
		}
	}
	const Blk_Info *b=get_Neighbor(c,NB_D);
	if(!check_Support(d,b,NB_U)&&!((d.flags&F_SELF)&&is_SameBase(b,c.self))){
		return FX_AIR;
	}
	if((d.flags&F_NO_MAGMA)&&b&&has_Kind(b,PF_MAGMA)){/*先查b再读别的格，b的指针更稳*/
		return FX_AIR;
	}
	if((d.flags&F_WATER)&&!(c.self->flags&BF_WATER)){/*自己不是水里的方块（海草/海带/气泡柱本身都含水）*/
		return FX_AIR;
	}
	return FX_KEEP;
}
static int judge_Vine(const Fix_Def &d,Rules_Ctx &c){/*藤蔓（VineBlock.getUpdatedState）：每个面单独判，撑不住的面关掉*/
	static const char *faces[]={"north","south","east","west","up"};
	int keep_cnt=0;
	const char *bad[5];
	int bad_cnt=0;
	for(int i=0;i<5;i++){
		if(!is_PropValue(c.self,faces[i],"true")){
			continue;
		}
		bool ok;
		if(!strcmp(faces[i],"up")){/*挂在上面：原版调的是 isAcceptableNeighbour(上方, DOWN)，canAttachTo 拿 DOWN 的反面——
			  看的是**上方方块的顶面**（支撑面或碰撞面整面），不是贴着藤蔓的底面。所以上半砖/倒楼梯/关着的上半活板门下面能挂，
			  营火/耕地/讲台/附魔台/阳光探测器/下半砖下面不能挂（它们顶面不满），树叶可以（碰撞面满）*/
			ok=can_FaceAttach(get_Neighbor(c,NB_U),NB_U);
		}else{/*侧面（canSupportAtFace）：背后那块朝这边的面整面；或者上面那格是带同一个面的藤蔓。
		        旁边那格是藤蔓不算（原版没有这条）*/
			int fi=get_DirIndex(faces[i]);
			const Blk_Info *side=get_Neighbor(c,fi);
			ok=can_FaceAttach(side,get_OppositeDir(fi));
			if(!ok){
				const Blk_Info *up=get_Neighbor(c,NB_U);
				if(is_SameBase(up,c.self)&&is_PropValue(up,faces[i],"true")){
					ok=true;
				}
			}
		}
		if(ok){
			keep_cnt++;
		}else{
			bad[bad_cnt++]=faces[i];
		}
	}
	if(!keep_cnt){
		return FX_AIR;
	}
	if(bad_cnt){
		const char *vals[5];
		for(int i=0;i<bad_cnt;i++){
			vals[i]="false";
		}
		return set_OutBlock(c,edit_State(c.self,bad,vals,bad_cnt),true);/*关掉撑不住的面，保留方块实体*/
	}
	(void)d;
	return FX_KEEP;
}
static int judge_Face6(const Fix_Def &d,Rules_Ctx &c){/*六个面各查一遍（发光地衣/幽匿脉络/树脂团）*/
	(void)d;
	static const char *faces[]={"down","up","north","south","east","west"};
	int keep_cnt=0;
	const char *bad[6];
	int bad_cnt=0;
	for(int i=0;i<6;i++){
		if(!is_PropValue(c.self,faces[i],"true")){
			continue;
		}
		int fi=get_DirIndex(faces[i]);/*支撑块在 faces[i] 那边，它朝我们的是反方向那一面*/
		if(fi>=0&&can_FaceAttach(get_Neighbor(c,fi),get_OppositeDir(fi))){/*支撑面或碰撞面整面（树叶可以）*/
			keep_cnt++;
		}else{
			bad[bad_cnt++]=faces[i];
		}
	}
	if(!keep_cnt){
		return FX_AIR;
	}
	if(bad_cnt){
		const char *vals[6];
		for(int i=0;i<bad_cnt;i++){
			vals[i]="false";
		}
		return set_OutBlock(c,edit_State(c.self,bad,vals,bad_cnt),true);
	}
	return FX_KEEP;
}
static int judge_Side(const Fix_Def &d,Rules_Ctx &c){/*贴一面：facing的反方向（face=floor/ceiling时看下/上）*/
	const char *face=get_Prop(c.self,"face");
	const char *facing=get_Prop(c.self,"facing");
	const Blk_Info *sup=NULL;
	int dir=NB_U;/*支撑块朝我们的是哪一面（dir=从支撑块指向自己）*/
	if(face&&!strcmp(face,"floor")){
		sup=get_Neighbor(c,NB_D);
		dir=NB_U;
	}else if(face&&!strcmp(face,"ceiling")){
		sup=get_Neighbor(c,NB_U);
		dir=NB_D;
	}else if(!facing){
		return FX_KEEP;/*没有facing属性（坏存档/以后版本改了属性名）：判断不了贴在哪面，宁可漏拆也不猜着拆*/
	}else{
		int fi=get_DirIndex(facing);
		if(fi<0){
			return FX_KEEP;/*facing的值不认识：同上，宁可漏拆*/
		}
		sup=get_OppositeNeighbor(c,facing);/*贴着的块在 facing 的反方向；它朝我们的是 facing 那一面*/
		dir=fi;
	}
	if(!check_Support(d,sup,dir)){
		return FX_AIR;
	}
	return FX_KEEP;
}
static int judge_Above(const Fix_Def &d,Rules_Ctx &c){/*上面要支持（孢子花、垂根、洞穴藤蔓）*/
	const Blk_Info *u=get_Neighbor(c,NB_U);
	if(!check_Support(d,u,NB_D)){/*支撑块在上面，朝下那一面（NB_D）*/
		return FX_AIR;
	}
	return FX_KEEP;
}
static int judge_Rim(const Fix_Def &d,Rules_Ctx &c){/*下面要顶面带边（铁轨、中继器、比较器）*/
	const Blk_Info *b=get_Neighbor(c,NB_D);
	if(!is_Rim(b)){
		return FX_AIR;
	}
	const char *sh=get_Prop(c.self,"shape");
	if(sh&&!strncmp(sh,"ascending_",10)){/*上坡铁轨（BaseRailBlock.shouldBeRemoved）：往上走那一侧的邻居顶面也要带边*/
		int di=get_DirIndex(sh+10);
		if(di>=0&&!is_Rim(get_Neighbor(c,di))){
			return FX_AIR;
		}
	}
	if((d.flags&F_NO_MAGMA)&&b&&has_Kind(b,PF_MAGMA)){
		return FX_AIR;
	}
	if((d.flags&F_WATER)&&!(c.self->flags&BF_WATER)){/*自己不是水里的方块（海草/海带/气泡柱本身都含水）*/
		return FX_AIR;
	}
	return FX_KEEP;
}
static int judge_Hang(const Fix_Def &d,Rules_Ctx &c){/*看属性决定挂上面还是站下面*/
	const char *v=get_Prop(c.self,d.key?d.key:"hanging");
	bool hang=v&&!strcmp(v,"true");
	const Blk_Info *sup=hang?get_Neighbor(c,NB_U):get_Neighbor(c,NB_D);
	if(!check_Support(d,sup,hang?NB_D:NB_U)){/*龟蛋底面有中心支撑（shape），挂在它下面的灯笼能留*/
		return FX_AIR;
	}
	return FX_KEEP;
}
static int judge_Hang2(const Fix_Def &d,Rules_Ctx &c){/*悬挂告示牌：上下有一边搭着就行，都空才拆*/
	if(check_Support(d,get_Neighbor(c,NB_U),NB_D)||check_Support(d,get_Neighbor(c,NB_D),NB_U)){
		return FX_KEEP;
	}
	return FX_AIR;
}
static bool is_Door(const Blk_Info *b){/*门（DoorBlock）：名字以 _door 结尾（活板门是 _trapdoor，不算）*/
	return b&&has_Suffix(b->base,"_door");
}
static bool is_SameState(const Blk_Info *self,const Block &b){/*b 和这一格现在的样子一样吗（名字+写出来的属性）*/
	return b.name()==self->name&&b.properties==(self->props?*self->props:nbt_Compound());
}
static int judge_Door(const Fix_Def &d,Rules_Ctx &c){/*门（DoorBlock.updateShape）：下半先看下面顶面整面（canSurvive）；
	然后看另一半（下半看上、上半看下）：是门、half 相反就把自己改成“那一半的样子、half 换成自己的”——
	别的门（橡木门上半搭着铁门下半会变成铁门上半）、朝向/开关/铰链不一样都照它改；不是门或 half 一样就变空气。
	谁先被判谁照对方改，改完两半一致，对方再判就不动了（收敛见 rules.hpp）*/
	const char *half=get_Prop(c.self,"half");
	bool upper=half&&!strcmp(half,"upper");
	if(!upper&&!check_Support(d,get_Neighbor(c,NB_D),NB_U)){
		return FX_AIR;
	}
	const Blk_Info *o=get_Neighbor(c,upper?NB_D:NB_U);
	if(!o){
		return FX_KEEP;/*读不出来：blind 已经置上*/
	}
	if(!is_Door(o)||!is_PropValue(o,"half",upper?"lower":"upper")){
		return FX_AIR;
	}
	Block b=copy_State(o);
	b.properties.set_String("half",upper?"upper":"lower");
	if(is_SameState(c.self,b)){
		return FX_KEEP;
	}
	return set_OutBlock(c,std::move(b),false);
}
static int judge_Cocoa(const Fix_Def &d,Rules_Ctx &c){/*可可豆：facing那一面是丛林原木*/
	const char *facing=get_Prop(c.self,"facing");
	if(!facing){
		return FX_KEEP;/*没有facing：判断不了贴哪面，宁可漏拆（正常存档一定有）*/
	}
	int fi=get_DirIndex(facing);/*可可豆在 facing 那一边的方块上；那个方块朝我们的是 facing 的反面*/
	if(!check_Support(d,fi>=0?get_Neighbor(c,fi):NULL,fi>=0?get_OppositeDir(fi):NB_U)){
		return FX_AIR;
	}
	return FX_KEEP;
}
static Block make_StemState(const Blk_Info *self){/*结果的瓜茎→普通瓜茎 age=7（attached_melon_stem→melon_stem），命名空间照留*/
	std::string n(self->name);
	size_t p=n.find("attached_");
	if(p!=std::string::npos){
		n.erase(p,9);
	}
	Block o{nbt_String(std::move(n))};
	o.properties.set_String("age","7");
	return o;
}
static int judge_Stem(const Fix_Def &d,Rules_Ctx &c){/*结果的瓜茎（AttachedStemBlock）：下面耕地；facing 那面的果实没了，
	原版是变回普通瓜茎（age=7），不是拆掉。普通瓜茎不会再变回结果的，所以这是单向的（收敛见 rules.hpp）*/
	if(!check_Support(d,get_Neighbor(c,NB_D),NB_U)){
		return FX_AIR;
	}
	const char *facing=get_Prop(c.self,"facing");
	if(!facing){
		return FX_KEEP;/*没有facing：不知道瓜在哪面，宁可漏拆（正常存档一定有）*/
	}
	const Blk_Info *fruit=get_NeighborAt(c,facing);
	if(!fruit){
		return FX_KEEP;/*读不出来：blind 已经置上*/
	}
	if(!d.key||fruit->base!=d.key){
		return set_OutBlock(c,make_StemState(c.self),false);
	}
	return FX_KEEP;
}
static int set_LinkState(Rules_Ctx &c,Block o);
static bool is_Speleothem(const Blk_Info *b){/*#speleothems：滴水石锥（26.3 起还有硫磺尖刺 sulfur_spike）*/
	return is_Vanilla(b)&&(b->base=="pointed_dripstone"||b->base=="sulfur_spike");
}
static bool is_DripWithDir(const Blk_Info *b,const char *dir){/*isPointedDripstoneWithDirection（26.3：isSpeleothemWithDirection）：是石锥、尖朝 dir*/
	return is_Speleothem(b)&&is_PropValue(b,"vertical_direction",dir);
}
static int judge_Drip(const Fix_Def &d,Rules_Ctx &c){/*滴水石锥：朝下（钟乳石）看上，朝上（石笋）看下；活得下去再照游戏重算粗细*/
	const char *v=get_Prop(c.self,"vertical_direction");
	bool up=v&&!strcmp(v,"up");/*石笋朝上→下面撑着；钟乳石朝下→上面挂着（PointedDripstoneBlock.isValidPointedDripstonePlacement 的 tipDirection）*/
	const char *tip_dir=up?"up":"down",*base_dir=up?"down":"up";
	const Blk_Info *sup=up?get_Neighbor(c,NB_D):get_Neighbor(c,NB_U);
	(void)d;
	/*根那一头（isValidPointedDripstonePlacement / 26.3 isValidSpeleothemPlacement）：朝尖那一面整面，或者是同一种、尖同向的石锥
	  （石锥的面从来不整面；26.3 起滴水石锥和硫磺尖刺不能接在对方上）*/
	if(!(is_DripWithDir(sup,tip_dir)&&sup->name==c.self->name)&&!is_FaceFull(sup,up?NB_U:NB_D)){
		return FX_AIR;
	}
	if(!v||(strcmp(v,"up")&&strcmp(v,"down"))){
		return FX_KEEP;/*没写朝向：算不了粗细*/
	}
	/*粗细（PointedDripstoneBlock.calculateDripstoneThickness）：只看尖那一头的邻居（front）和根那一头的邻居（behind）。
	  front 是尖朝我的滴水石锥＝两个尖对上了（tip_merge）；front 不是同向的滴水石锥＝我是尖（tip）；
	  front 是同向的、它是尖＝我是 frustum；它不是尖：behind 不是同向的滴水石锥＝我是根（base），是＝中间（middle）。
	  收敛：粗细只沿“朝尖那一头”往回看前一格的粗细（尖那一格不看别人的粗细），不成环；两个尖对上只会从 tip 变成 tip_merge*/
	const Blk_Info *front=get_Neighbor(c,up?NB_U:NB_D);
	if(!front){
		return FX_KEEP;
	}
	const char *th=get_Prop(c.self,"thickness");
	bool merge=th&&!strcmp(th,"tip_merge");
	const char *nt;
	if(is_DripWithDir(front,base_dir)&&front->name==c.self->name){/*两个尖对上：得是同一种石锥（26.1.1 只有滴水石锥）*/
		nt=!merge&&!is_PropValue(front,"thickness","tip_merge")?"tip":"tip_merge";
	}else if(!is_DripWithDir(front,tip_dir)){
		nt="tip";
	}else if(!is_PropValue(front,"thickness","tip")&&!is_PropValue(front,"thickness","tip_merge")){
		const Blk_Info *behind=get_Neighbor(c,up?NB_D:NB_U);
		if(!behind){
			return FX_KEEP;
		}
		nt=is_DripWithDir(behind,tip_dir)?"middle":"base";
	}else{
		nt="frustum";
	}
	const char *k[1]={"thickness"},*val[1]={nt};
	return set_LinkState(c,edit_State(c.self,k,val,1));
}
static int judge_Bell(const Fix_Def &d,Rules_Ctx &c){/*钟（BellBlock.canSurvive/updateShape）：attachment=floor/ceiling/single_wall/double_wall*/
	const char *at=get_Prop(c.self,"attachment");
	(void)d;
	if(at&&!strcmp(at,"floor")){/*下面顶面整面*/
		return is_FaceFull(get_Neighbor(c,NB_D),NB_U)?FX_KEEP:FX_AIR;
	}
	if(at&&!strcmp(at,"ceiling")){/*上面底面中心支撑*/
		return is_FaceCenter(get_Neighbor(c,NB_U),NB_D)?FX_KEEP:FX_AIR;
	}
	/*贴墙：支撑块在 **facing 那一侧**（getConnectedDirection 是 facing 的反面，canSurvive 再取一次反面），
	  它朝钟的那一面要整面。以前照 wiki 写成 facing 的反方向，贴墙的钟全会被拆错。
	  两面都贴（double_wall）的原版从不直接拆：一边没了先变成贴另一边的 single_wall，所以有一边撑着就算。*/
	const char *f=get_Prop(c.self,"facing");
	int fi=get_DirIndex(f);
	if(fi<0){
		return FX_KEEP;/*没有facing：判断不了贴哪面，宁可漏拆*/
	}
	if(is_FaceFull(get_Neighbor(c,fi),get_OppositeDir(fi))){
		return FX_KEEP;
	}
	if(at&&!strcmp(at,"double_wall")&&is_FaceFull(get_Neighbor(c,get_OppositeDir(fi)),fi)){
		return FX_KEEP;
	}
	return FX_AIR;
}
static int get_ScaffDistance(const Blk_Info *b){/*脚手架存的 distance（0~7）；读不出来当 7*/
	const char *v=get_Prop(b,"distance");
	return v&&v[0]>='0'&&v[0]<='7'&&!v[1]?v[0]-'0':7;
}
static int judge_Scaffolding(const Fix_Def &d,Rules_Ctx &c){/*脚手架（ScaffoldingBlock.getDistance<7）：照原版现算距离——
	下面是脚手架就取它的 distance，下面是别的方块且顶面整面就是 0；再和四个水平方向的脚手架 distance+1 取小。
	用的是邻居存着的 distance（原版也是），不是自己存的*/
	(void)d;
	const Blk_Info *b=get_Neighbor(c,NB_D);
	if(!b){
		return FX_KEEP;/*读不出来：blind 已经置上*/
	}
	int dist=7;
	bool below_scaff=b->base=="scaffolding";
	if(below_scaff){
		dist=get_ScaffDistance(b);
	}else if(is_FaceFull(b,NB_U)){
		dist=0;
	}
	for(int i=0;dist>1&&i<4;i++){
		const Blk_Info *s=get_Neighbor(c,nb_h[i]);
		if(s&&s->base=="scaffolding"){
			dist=std::min(dist,get_ScaffDistance(s)+1);
		}
	}
	if(dist>=7){
		return FX_AIR;
	}
	/*活得下去：distance、bottom 照 ScaffoldingBlock.tick 改成算出来的（bottom＝distance>0 且下面不是脚手架）。
	  收敛：distance 只由邻居存着的 distance 决定，封顶 7（到 7 就拆），和游戏一样是有上限的最短路，改有限次就停*/
	char ds[2]={(char)('0'+dist),0};
	const char *k[2]={"distance","bottom"},*val[2]={ds,dist>0&&!below_scaff?"true":"false"};
	return set_LinkState(c,edit_State(c.self,k,val,2));
}
static int judge_SmallDripleaf(const Fix_Def &d,Rules_Ctx &c){/*小垂滴叶：黏土/苔藓直接放，泥土类要这格有水*/
	(void)d;
	const char *half=get_Prop(c.self,"half");
	if(half&&!strcmp(half,"upper")){
		const Blk_Info *b=get_Neighbor(c,NB_D);
		if(!is_SameBase(b,c.self)||!is_PropValue(b,"half","lower")){
			return FX_AIR;
		}
		return FX_KEEP;
	}
	const Blk_Info *u=get_Neighbor(c,NB_U);/*下半：上面得是自己的上半（DoublePlantBlock）*/
	if(!is_SameBase(u,c.self)||!is_PropValue(u,"half","upper")){
		return FX_AIR;
	}
	const Blk_Info *b=get_Neighbor(c,NB_D);
	std::string_view n=b?b->base:std::string_view();/*读不出来时给空串：下面两个集合都不命中，交给blind作废*/
	for(int i=0;set_small_dripleaf[i];i++){
		if(n==set_small_dripleaf[i]){
			return FX_KEEP;
		}
	}
	for(int i=0;set_veg[i];i++){/*原版第二段走的是 VegetationBlock.mayPlaceOn=#supports_vegetation（比substrate多耕地）*/
		if(n==set_veg[i]){
			return is_PropValue(c.self,"waterlogged","true")?FX_KEEP:FX_AIR;
		}
	}
	return FX_AIR;
}
static int judge_Propagule(const Fix_Def &d,Rules_Ctx &c){/*胎生苗：挂着就贴树叶，种着就看下面*/
	if(is_PropValue(c.self,"hanging","true")){
		const Blk_Info *u=get_Neighbor(c,NB_U);/*原版：上面必须是 #supports_hanging_mangrove_propagule（=红树叶），
		                                    挂在别的树叶下面原版会掉（以前这里写成"是树叶就行"，漏拆）*/
		if(!u||!is_InSet(set_mangrove_leaves,u)){
			return FX_AIR;
		}
		return FX_KEEP;
	}
	if(!check_Support(d,get_Neighbor(c,NB_D),NB_U)){
		return FX_AIR;
	}
	return FX_KEEP;
}
static int judge_Chorus(const Fix_Def &d,Rules_Ctx &c){/*紫颂花（26.1.1 的 ChorusFlowerBlock.canSurvive 原样搬过来）：
	下面必须是紫颂植株或 #supports_chorus_flower（=末地石）；下面真是空气时，才轮到
	"水平方向正好一个紫颂植株"，而且其余水平方向必须全是空气（旁边杵着别的方块一样碎）。
	都不满足就碎掉（不掉落）。*/
	(void)d;
	const Blk_Info *b=get_Neighbor(c,NB_D);
	if(b&&!is_Air(b)){/*下面有东西：只认紫颂植株/末地石（紫颂花在下面也不行，原版就是碎的）*/
		return (b->base=="chorus_plant"||is_InSet(set_chorus,b))?FX_KEEP:FX_AIR;
	}
	int cnt=0;
	for(int i=0;i<4;i++){
		const Blk_Info *s=get_Neighbor(c,nb_h[i]);
		if(s&&s->base=="chorus_plant"){
			if(++cnt>1){
				return FX_AIR;/*"正好一个"：两个以上原版也不长*/
			}
		}else if(!is_Air(s)){
			return FX_AIR;/*旁边不是空气也不是紫颂植株：原版照样碎*/
		}
	}
	return cnt==1?FX_KEEP:FX_AIR;/*0个：没靠山*/
}
static int set_ChorusLinks(Rules_Ctx &c){/*活得下去的紫颂植株照 ChorusPlantBlock.updateShape 重算六个方向连不连：
	那边是紫颂植株或紫颂花就连，向下还认 #supports_chorus_plant（末地石）。只认名字，谁也不靠它连没连活
	（中心支撑跟着 up/down 变，但紫颂花看的是下面是不是紫颂植株，不看形状）*/
	static const char *keys[6]={"east","west","up","down","south","north"};/*NB_* 的顺序*/
	const char *vals[6];
	for(int i=0;i<6;i++){
		const Blk_Info *n=get_Neighbor(c,i);
		if(!n){
			return FX_KEEP;
		}
		if(!has_Link(n,CK_VANILLA)){
			return FX_KEEP;/*模组方块：在不在 #supports_chorus_plant 不知道*/
		}
		bool on=n->base=="chorus_plant"||n->base=="chorus_flower"||(i==NB_D&&is_InSet(set_chorus,n));
		vals[i]=on?"true":"false";
	}
	Block o=edit_State(c.self,keys,vals,6);
	if(is_SameState(c.self,o)){
		return FX_KEEP;
	}
	return set_OutBlock(c,std::move(o),false);
}
static int judge_ChorusPlant(const Fix_Def &d,Rules_Ctx &c){/*紫颂植株（ChorusPlantBlock.canSurvive）：
		for(水平四个方向){
		    那个方向是紫颂植株吗？是的话：
		        上面和下面都不是空气 → 碎
		        那株的下面（斜下方）是紫颂植株/末地石 → 留；斜下方六面里看不到 → 留着（宁可漏拆）
		}
		下面是紫颂植株/#supports_chorus_plant（末地石）→ 留，否则碎
	第一条照原版执行：末地自然生成的树里有极少数这种格子（旁边是另一株矮桩、上面又是自己那截树干），
	原版下一次方块更新会把它连着一截树干拆掉，fixer 提前做完（以前实测 1024 个末地区块拆 171 格，含连锁）。
	活得下去再照游戏重算六个方向的连接（set_ChorusLinks）*/
	(void)d;
	const Blk_Info *b=get_Neighbor(c,NB_D);
	bool below_ok=b&&(b->base=="chorus_plant"||is_InSet(set_chorus,b));
	bool vertical=!is_Air(get_Neighbor(c,NB_U))&&!is_Air(b);
	for(int i=0;i<4;i++){
		const Blk_Info *s=get_Neighbor(c,nb_h[i]);
		if(!s||s->base!="chorus_plant"){
			continue;
		}
		if(vertical){
			return FX_AIR;
		}
		return set_ChorusLinks(c);/*旁边那株的根在斜下方，六面里看不到；宁可留着*/
	}
	return below_ok?set_ChorusLinks(c):FX_AIR;
}
static int judge_Snow(const Fix_Def &d,Rules_Ctx &c){/*雪层：26.1 的两个标签先看
	（#cannot_support_snow_layer={barrier,ice,packed_ice} 优先于 #support_override_snow_layer={honey_block,mud,soul_sand}），
	其余情况要下面那格"顶面完整"（原版 full top face；不是铁轨的"顶面带边"）*/
	(void)d;
	const Blk_Info *b=get_Neighbor(c,NB_D);
	if(!b){/*读不出来：blind已经置上了，外面会整格丢掉（这里给什么都会被忽略）*/
		return FX_AIR;
	}
	if(is_InSet(set_snow_no,b)){
		return FX_AIR;
	}
	if(is_InSet(set_snow_over,b)){
		return FX_KEEP;
	}
	if(b->base=="snow"&&is_PropValue(b,"layers","8")){
		return FX_KEEP;/*8层雪：碰撞箱顶面不满，原版单独放行*/
	}
	return (get_Shape(b)&sh_Coll(NB_U))?FX_KEEP:FX_AIR;/*SnowLayerBlock.canSurvive 看的是碰撞箱顶面满不满（树叶上能积雪）*/
}
static Block make_ConcreteState(const Blk_Info *self){/*混凝土粉末→对应的混凝土（white_concrete_powder→white_concrete）：
	照原版 ConcretePowderBlock.onLand/updateShape，碰到水就变混凝土；混凝土是整方块、不在规则表里，
	换过去就再也不会被判到（rules.hpp 文件头的第 1 种改动：越判越少）。名字整个保留只去掉 _powder，别丢命名空间；
	不带属性（混凝土没有方块属性；万一以后版本给粉末加了属性，也别把混凝土写成一个不存在的状态）*/
	std::string n(self->name);
	size_t p=n.find("_powder");
	if(p!=std::string::npos){
		n.erase(p,7);
	}
	return Block(nbt_String(std::move(n)));
}
static int judge_Falling(const Fix_Def &d,Rules_Ctx &c){/*重力方块：正下方 FallingBlock.isFree（空气、火、液体、可替换方块：
	草、雪层、藤蔓…，见 is_FreeBelow）就拆；含水方块托得住。
	fixer不生成掉落物实体，替原版把这次更新做完就是拆掉（和拆别的浮空方块一个意思）。
	混凝土粉末特殊：原版先看"碰没碰到水"（updateShape→touchesLiquid），碰到就凝固成混凝土、根本不会掉；
	所以先判水，再判掉不掉。*/
	(void)d;
	const Blk_Info *b=get_Neighbor(c,NB_D);
	if(!b){/*读不出来：blind已经置上，外面会整格丢掉（这里给什么都会被忽略）*/
		return FX_AIR;
	}
	if(has_Suffix(c.self->base,"_concrete_powder")&&is_TouchingWater(c)){
		return set_OutBlock(c,make_ConcreteState(c.self),false);
	}
	if(is_FreeBelow(b)){
		return FX_AIR;
	}
	return FX_KEEP;
}
static int set_WaterSource(Rules_Ctx &c,int fx){/*这格换成水源（level=0），并补一条水的流体刻让它流开：
	和地图里别的水一模一样；t=5 是水的流动间隔（Wiki Water：water flows every 5 game ticks），p=0。
	用在霜冰化水（FX_SET）和含水方块拆完留水（FX_AIR）*/
	Block w("minecraft:water");
	w.properties.set_String("level","0");
	c.out_block=std::move(w);
	c.out_keep_be=false;
	c.out_tick.type="minecraft:water";
	c.out_tick.fluid=true;
	c.out_tick.delay=5;
	c.out_tick.priority=0;
	return fx;
}
static int judge_Frost(const Fix_Def &d,Rules_Ctx &c){/*霜冰——不看支撑、不看光照，见到就换成水。
	依据（minecraft.wiki/w/Frosted_Ice，原始HTML留在 test/work/wiki/Frosted_Ice.html）：
	  · "Frosted ice is a translucent block created when a mob or entity wearing Frost Walker-enchanted boots
	     moves over water"：它本来就只是"冰霜行者踩过水面"的临时产物，不是该长期存在的地形；
	  · "Frosted ice naturally melts fairly quickly ... When the age reaches 4, the block turns into water"：
	    融化的终点就是水（Fixer 写的是水源 level=0，和周围的水一样）；
	  · "in places with low light levels, such as underground, at night or in the End, it never melts
	     unless broken"：原版判融化要读内部光照（我们读不到光照图），而光照低的地方它本来就赖着不化——
	    所以这里**不判光照**：见到霜冰就当它该化了（用户的服务端bug会往存档里写一大片霜冰，正是要清掉的）。
	代价：玩家穿着冰霜行者靴子刚踩出来、还没化的霜冰也会被一起化掉（那本来就该化，只是化得早了点）。
	换成水仍然"越判越少"（rules.hpp 文件头的第 1 种改动）：霜冰是整方块且在规则表里，
	水谁都不管、什么也撑不住，换过去以后这一格不会再被判到*/
	(void)d;
	return set_WaterSource(c,FX_SET);
}
static int judge_Bed(const Fix_Def &d,Rules_Ctx &c){/*床（BedBlock.updateShape）：脚（foot）在 facing 那边找头，头在反面找脚；
	那一格得是同一种床、part 相反，不然这一半变空气。床本身不要下面的支撑*/
	(void)d;
	const char *f=get_Prop(c.self,"facing");
	int fi=get_DirIndex(f);
	if(fi<0||!is_Horizontal(fi)){
		return FX_KEEP;/*没有facing：判断不了另一半在哪，宁可漏拆*/
	}
	bool foot=is_PropValue(c.self,"part","foot");
	const Blk_Info *o=get_Neighbor(c,foot?fi:get_OppositeDir(fi));
	if(!o){
		return FX_KEEP;/*读不出来：blind 已经置上*/
	}
	if(!is_SameBase(o,c.self)||is_PropValue(o,"part",foot?"foot":"head")){
		return FX_AIR;
	}
	return FX_KEEP;
}
static int judge_PistonHead(const Fix_Def &d,Rules_Ctx &c){/*活塞头（PistonHeadBlock.canSurvive）：facing 的反面那格是
	同朝向的 moving_piston，或者同朝向、extended=true、类型对得上（type=normal→piston，sticky→sticky_piston）的活塞*/
	(void)d;
	const char *f=get_Prop(c.self,"facing");
	int fi=get_DirIndex(f);
	if(fi<0){
		return FX_KEEP;
	}
	const Blk_Info *b=get_Neighbor(c,get_OppositeDir(fi));
	if(!b){
		return FX_KEEP;
	}
	if(!is_PropValue(b,"facing",f)){
		return FX_AIR;
	}
	if(b->base=="moving_piston"){
		return FX_KEEP;
	}
	const char *want=is_PropValue(c.self,"type","sticky")?"sticky_piston":"piston";
	return b->base==want&&is_PropValue(b,"extended","true")?FX_KEEP:FX_AIR;
}
static int judge_PaleCarpet(const Fix_Def &d,Rules_Ctx &c){/*苍白苔藓地毯（MossyCarpetBlock.updateShape）：先 canSurvive——铺地的那块
	（bottom=true）下面不是空气，挂在上面那截（bottom=false）下面是铺地的那块；然后照 getUpdatedState 重算四个侧面：
	  那一边能贴（MultifaceBlock.canAttachTo）才有面，不能贴就是 none；
	  铺地的那块能贴就是 low（原版对铺地的 createSides 恒为真，所以会长出面来），再看上面那截同一边有面就变 tall；
	  上面那截能贴就留原来的值，原来是 low 的话：再上面一格是“上面那截”且同一边有面变 tall，下面那块同一边是 none 就变 none。
	上面那截一个侧面都不剩就变空气。属性没写的照原版默认值（bottom=true、侧面 none）。
	收敛：上面那截的面只会关（low→tall 也只一次），铺地那块的面只跟着侧面邻居和上面那截走（见 rules.hpp 第 3 种）*/
	(void)d;
	const Blk_Info *b=get_Neighbor(c,NB_D);
	if(!b){
		return FX_KEEP;/*读不出来：blind 已经置上*/
	}
	bool base=!is_PropValue(c.self,"bottom","false");
	if(base?is_Air(b):(b->base!="pale_moss_carpet"||is_PropValue(b,"bottom","false"))){
		return FX_AIR;
	}
	static const char *sides[4]={"north","east","south","west"};
	static const int dirs[4]={NB_N,NB_E,NB_S,NB_W};
	const char *vals[4];
	bool any=false;
	for(int i=0;i<4;i++){
		const Blk_Info *n=get_Neighbor(c,dirs[i]);
		if(!n){
			return FX_KEEP;
		}
		const char *v="none";
		if(can_FaceAttach(n,get_OppositeDir(dirs[i]))){
			const char *cur=get_Prop(c.self,sides[i]);
			v=base?"low":(cur?cur:"none");
		}
		if(!strcmp(v,"low")){/*原版到这里才去读上面/下面那格*/
			const Blk_Info *u=get_Neighbor(c,NB_U);
			if(!u){
				return FX_KEEP;
			}
			const char *uv=get_Prop(u,sides[i]);
			if(u->base=="pale_moss_carpet"&&uv&&strcmp(uv,"none")&&is_PropValue(u,"bottom","false")){
				v="tall";
			}
			const char *bv=get_Prop(b,sides[i]);
			if(!base&&(!bv||!strcmp(bv,"none"))){
				v="none";
			}
		}
		vals[i]=v;
		any=any||strcmp(v,"none");
	}
	if(!base&&!any){
		return FX_AIR;
	}
	Block o=edit_State(c.self,sides,vals,4);
	if(is_SameState(c.self,o)){
		return FX_KEEP;
	}
	return set_OutBlock(c,std::move(o),false);
}
static std::string make_Name(const Blk_Info *self,const char *base){/*同一个命名空间下的另一种方块（minecraft:kelp→minecraft:kelp_plant）*/
	std::string_view n=self->name;
	size_t p=n.find(':');
	return (p==std::string_view::npos?std::string():std::string(n.substr(0,p+1)))+base;
}
static int get_PosRandom(const Rules_Ctx &c,int n){/*原版这里用随机数（藤头的 age）；fixer 要可重复，按坐标散列出 0..n-1*/
	uint32_t h=(uint32_t)c.x*0x9E3779B1u^(uint32_t)c.y*0x85EBCA77u^(uint32_t)c.z*0xC2B2AE3Du;
	h^=h>>15;
	h*=0x2C1B3C6Du;
	h^=h>>12;
	return (int)(h%(uint32_t)n);
}
static int judge_Fire(const Fix_Def &d,Rules_Ctx &c){/*火（FireBlock.updateShape）：活不下去（下面顶面不整面、六邻也没有可燃的）变空气；
	活得下去就重算样子（BaseFireBlock.getState）：下面是 #soul_fire_base_blocks 变灵魂火；否则下面可燃或顶面整面＝地上的火（五个面全关），
	不然五个面各看那一边可不可燃。age 照留。灵魂火（SoulFireBlock.updateShape）：下面是灵魂沙/灵魂土才留。
	火的面只跟着六邻走、谁也不靠火的面活，所以开面也不影响收敛（见 rules.hpp）。改了样子补一条火的方块刻（原版 onPlace 排 30+随机10 刻），
	不然这团火就再也不烧不灭了*/
	(void)d;
	const Blk_Info *b=get_Neighbor(c,NB_D);
	if(!b){
		return FX_KEEP;
	}
	bool soul_base=b->base=="soul_sand"||b->base=="soul_soil";
	if(c.self->base=="soul_fire"){
		return soul_base?FX_KEEP:FX_AIR;
	}
	bool sturdy=is_FaceFull(b,NB_U);
	bool burn[6];
	bool any=false;
	for(int i=0;i<6;i++){
		const Blk_Info *n=get_Neighbor(c,i);
		if(!n){
			return FX_KEEP;
		}
		burn[i]=has_Kind(n,PF_BURN);
		any=any||burn[i];
	}
	if(!sturdy&&!any){
		return FX_AIR;
	}
	if(soul_base){
		return set_OutBlock(c,Block(nbt_String(make_Name(c.self,"soul_fire"))),false);
	}
	bool floor=burn[NB_D]||sturdy;
	static const char *keys[5]={"east","west","up","south","north"};
	static const int dirs[5]={NB_E,NB_W,NB_U,NB_S,NB_N};
	const char *vals[5];
	for(int i=0;i<5;i++){
		vals[i]=(!floor&&burn[dirs[i]])?"true":"false";
	}
	Block o=edit_State(c.self,keys,vals,5);
	if(is_SameState(c.self,o)){
		return FX_KEEP;
	}
	c.out_tick.type="minecraft:fire";
	c.out_tick.fluid=false;
	c.out_tick.delay=30;
	c.out_tick.priority=0;
	return set_OutBlock(c,std::move(o),false);
}
static int judge_Portal(const Fix_Def &d,Rules_Ctx &c){/*下界传送门（NetherPortalBlock.updateShape + PortalShape.findAnyShape）：
	门框平面里的方向（上下，axis=x 时东西、axis=z 时南北）来的更新，邻居不是传送门就重找门框，不完整（不是整块都是传送门、
	框不全是黑曜石）就变空气。门是一个矩形，里面一格的平面邻居要么在门里（得是传送门）要么在框上（得是黑曜石），
	所以那格既不是传送门也不是黑曜石＝一定不完整；是黑曜石就得看整个门框，六面里看不到，留着（宁可漏拆）。
	另一个水平轴方向来的更新原版不管*/
	(void)d;
	const char *ax=get_Prop(c.self,"axis");
	int a,b;
	if(ax&&!strcmp(ax,"x")){
		a=NB_E;b=NB_W;
	}else if(ax&&!strcmp(ax,"z")){
		a=NB_S;b=NB_N;
	}else{
		return FX_KEEP;
	}
	const int dirs[4]={NB_U,NB_D,a,b};
	for(int i=0;i<4;i++){
		const Blk_Info *n=get_Neighbor(c,dirs[i]);
		if(!n||n->base=="nether_portal"||n->base=="obsidian"){
			continue;
		}
		return FX_AIR;
	}
	return FX_KEEP;
}
/*---- 栅栏/墙的连接（只改样子、不拆）----
  FenceBlock/WallBlock.updateShape：四个水平方向各看邻居连不连（connectsTo）；墙还看上面那格：它碰撞箱的底面盖住哪条臂，
  那条臂就是 tall，不然是 low，要不要立柱子见 judge_Wall。原版是哪边的邻居变了重算哪边，六个方向都更新过一遍的结果就是这里
  一次算出来的样子（mcdump.sh cmp 比的就是这个）。属性没写的照原版默认值；挨着模组方块（标签/形状不知道）就整格不动。
  收敛（rules.hpp 第 3 种“跟着邻居走”）：新状态只由六邻定。栅栏/墙/玻璃板的侧面从来不是整面，所以它们互相只认名字、
  不认对方连没连；墙看上面的墙只往上看（下面的跟着上面的走，上面的不看下面），没有环；别的规则也不靠栅栏/墙连没连活
  （游戏会算出来的状态里，顶面/底面的中心支撑一直都在），所以每格只跟着邻居变有限几次*/
enum{LK_FENCE,LK_WALL,LK_BARS};/*谁在连：栅栏 / 墙 / 玻璃板和铁栏杆*/
static int get_LinkTo(const Blk_Info *n,int d,int kind,bool wooden){/*自己（LK_*）连不连 d 方向的邻居 n：
	1=连 0=不连 -1=不知道（模组方块；栅栏门 facing 读不出来）。
	  栅栏 FenceBlock.connectsTo：同一类栅栏（#fences 里木的只连木的）、门板横在 d 的垂直方向上的栅栏门、朝这边整面的方块；
	  墙 WallBlock.connectsTo：别的墙、铁栏杆/玻璃板、同样的栅栏门、朝这边整面的方块；
	  玻璃板/铁栏杆 IronBarsBlock.attachsTo：别的玻璃板/铁栏杆、墙、朝这边整面的方块（栅栏门不连）。
	  整面的里面除掉 isExceptionForConnection（树叶/屏障/南瓜/雕刻南瓜/南瓜灯/西瓜/潜影盒）*/
	if(!has_Link(n,CK_VANILLA)){
		return -1;
	}
	if(kind!=LK_BARS&&has_Link(n,CK_GATE)){/*FenceGateBlock.connectsToDirection：门的 facing 和 d 垂直*/
		int f=get_DirIndex(get_Prop(n,"facing"));
		if(!is_Horizontal(f)){
			return -1;
		}
		if(get_Clockwise(f)==d||get_CounterClockwise(f)==d){
			return 1;
		}
	}
	if(kind==LK_FENCE?(has_Link(n,CK_FENCE)&&has_Link(n,CK_WOODEN)==wooden):(has_Link(n,CK_WALL)||has_Link(n,CK_BARS))){
		return 1;
	}
	return !has_Link(n,CK_NOLINK)&&is_FaceFull(n,get_OppositeDir(d))?1:0;
}
static int set_LinkState(Rules_Ctx &c,Block o){/*栅栏/墙重算出来的样子：一样就留着；改了的话含水的补一条水的流体刻
	（原版 updateShape 里含水就排一条 t=5；主机写这格时会删掉这格原来的刻）*/
	if(is_SameState(c.self,o)){
		return FX_KEEP;
	}
	if(is_PropValue(c.self,"waterlogged","true")){
		c.out_tick.type="minecraft:water";
		c.out_tick.fluid=true;
		c.out_tick.delay=5;
		c.out_tick.priority=0;
	}
	return set_OutBlock(c,std::move(o),false);
}
static int judge_CrossLink(Rules_Ctx &c,int kind){/*栅栏/玻璃板/铁栏杆（CrossCollisionBlock）：四个方向连不连，不看上下*/
	static const char *keys[4]={"east","west","south","north"};/*和 nb_h 同一个顺序*/
	const char *vals[4];
	bool wooden=has_Link(c.self,CK_WOODEN);
	for(int i=0;i<4;i++){
		const Blk_Info *n=get_Neighbor(c,nb_h[i]);
		if(!n){
			return FX_KEEP;/*读不出来：blind 已经置上*/
		}
		int on=get_LinkTo(n,nb_h[i],kind,wooden);
		if(on<0){
			return FX_KEEP;
		}
		vals[i]=on?"true":"false";
	}
	return set_LinkState(c,edit_State(c.self,keys,vals,4));
}
static int judge_Fence(const Fix_Def &d,Rules_Ctx &c){/*栅栏（FenceBlock.updateShape）*/
	(void)d;
	return judge_CrossLink(c,LK_FENCE);
}
static int judge_Bars(const Fix_Def &d,Rules_Ctx &c){/*玻璃板/铁栏杆（IronBarsBlock.updateShape）*/
	(void)d;
	return judge_CrossLink(c,LK_BARS);
}
static int judge_Gate(const Fix_Def &d,Rules_Ctx &c){/*栅栏门（FenceGateBlock.updateShape）：门板两头（facing 顺时针、逆时针那两边）
	有一边是 #walls 就 in_wall=true（门放低一截和墙齐平），不然 false。只是样子：支撑形状/碰撞箱和 in_wall 无关，谁也不靠它活*/
	(void)d;
	int f=get_DirIndex(get_Prop(c.self,"facing"));
	if(!is_Horizontal(f)){
		return FX_KEEP;
	}
	bool in=false;
	const int ends[2]={get_Clockwise(f),get_CounterClockwise(f)};
	for(int i=0;i<2;i++){
		const Blk_Info *n=get_Neighbor(c,ends[i]);
		if(!n){
			return FX_KEEP;
		}
		if(!has_Link(n,CK_VANILLA)){
			return FX_KEEP;/*模组方块：在不在 #walls 不知道*/
		}
		in=in||has_Link(n,CK_WALL);
	}
	const char *k[1]={"in_wall"};
	const char *v[1]={in?"true":"false"};
	return set_LinkState(c,edit_State(c.self,k,v,1));
}
static int judge_Snowy(const Fix_Def &d,Rules_Ctx &c){/*草方块/灰化土/菌丝（SnowyBlock.updateShape）：上面是 #snow（雪层/雪块/细雪）就 snowy=true*/
	(void)d;
	const Blk_Info *u=get_Neighbor(c,NB_U);
	if(!u){
		return FX_KEEP;
	}
	if(!has_Link(u,CK_VANILLA)){
		return FX_KEEP;
	}
	bool snowy=u->base=="snow"||u->base=="snow_block"||u->base=="powder_snow";
	const char *k[1]={"snowy"};
	const char *v[1]={snowy?"true":"false"};
	return set_LinkState(c,edit_State(c.self,k,v,1));
}
static bool is_CopperChest(const Blk_Info *b){/*#copper_chests：8 种铜箱子（都有 type）*/
	return has_Link(b,CK_VANILLA)&&has_Suffix(b->base,"copper_chest");
}
enum{CT_SINGLE=0,CT_LEFT=1,CT_RIGHT=2};/*箱子的 type 属性*/
static int get_ChestType(const Blk_Info *b){/*-1=没写/不认识*/
	const char *t=get_Prop(b,"type");
	if(!t){
		return -1;
	}
	return !strcmp(t,"single")?CT_SINGLE:!strcmp(t,"left")?CT_LEFT:!strcmp(t,"right")?CT_RIGHT:-1;
}
static int get_ChestLink(int f,int t){/*ChestBlock.getConnectedDirection：left 在 facing 顺时针那边，别的（right/single）在逆时针那边*/
	return t==CT_LEFT?get_Clockwise(f):get_CounterClockwise(f);
}
static int judge_Chest(const Fix_Def &d,Rules_Ctx &c){/*箱子（ChestBlock.updateShape，铜箱子再加 CopperChestBlock.updateShape）：
	照原版的顺序（下 上 北 南 西 东，和 mcdump.sh cmp 一样）一个方向一个方向更新——
	  那边是能连的箱子（普通箱子/陷阱箱只认同一种，铜箱子认任何铜箱子）、方向是水平的：自己是单箱、它是大箱子的一半、朝向一样、
	    它的另一半正指着自己 → 自己变成另一半（type 取反）；
	  那边不是能连的箱子：自己指着这边 → 变单箱（另一半没了）；
	  铜箱子：自己是大箱子、指着这边的铜箱子 → 换成那边的方块（氧化/打蜡程度和它对齐，属性照留），原版到这里就换了方块。
	指着的那边是同种箱子但对不上（朝向不一样、也是单箱…）原版不动，这里也不动。方块实体（箱子里的东西）照留。
	收敛：单箱变大箱子只发生一次（指着它的那一半不会再变：它的另一半就是自己）；大箱子变单箱只在另一半不是箱子了（被拆了）时；
	铜箱子对齐是“谁先判谁照对方改”，改完一样就不再动（见 rules.hpp 第 3 种）*/
	(void)d;
	int f=get_DirIndex(get_Prop(c.self,"facing"));
	int t=get_ChestType(c.self);
	if(!is_Horizontal(f)||t<0){
		return FX_KEEP;
	}
	bool copper=is_CopperChest(c.self);
	const Blk_Info *to=NULL;/*铜箱子换成哪一格的方块*/
	static const int order[6]={NB_D,NB_U,NB_N,NB_S,NB_W,NB_E};/*Direction.values() 的顺序*/
	for(int i=0;i<6&&!to;i++){
		int dir=order[i];
		const Blk_Info *n=get_Neighbor(c,dir);
		if(!n){
			return FX_KEEP;
		}
		bool can=copper?is_CopperChest(n):(has_Link(n,CK_VANILLA)&&n->base==c.self->base);
		if(can&&is_Horizontal(dir)){
			if(t==CT_SINGLE){
				int nt=get_ChestType(n),nf=get_DirIndex(get_Prop(n,"facing"));
				if(nt<0||!is_Horizontal(nf)){
					return FX_KEEP;
				}
				if(nt!=CT_SINGLE&&nf==f&&get_ChestLink(nf,nt)==get_OppositeDir(dir)){
					t=nt==CT_LEFT?CT_RIGHT:CT_LEFT;
				}
			}
		}else if(get_ChestLink(f,t)==dir){
			t=CT_SINGLE;
		}
		if(copper&&can&&t!=CT_SINGLE&&get_ChestLink(f,t)==dir){
			to=n;
		}
	}
	static const char *tn[3]={"single","left","right"};
	const char *k[1]={"type"};
	const char *v[1]={tn[t]};
	Block o=edit_State(c.self,k,v,1);
	if(to){
		o=Block(nbt_String(std::string(to->name)),o.properties);/*withPropertiesOf：两边属性一样，照留自己的*/
	}
	if(is_SameState(c.self,o)){
		return FX_KEEP;
	}
	if(is_PropValue(c.self,"waterlogged","true")){
		c.out_tick.type="minecraft:water";
		c.out_tick.fluid=true;
		c.out_tick.delay=5;
		c.out_tick.priority=0;
	}
	return set_OutBlock(c,std::move(o),true);/*箱子里的东西（方块实体）照留；铜箱子都是 minecraft:chest 方块实体*/
}
static uint32_t get_OffsetUnder(const Blk_Info *u,int32_t x,int32_t z){/*竹子/滴水石锥的碰撞箱是一根方柱，按坐标随机偏移
	（BlockBehaviour.Properties.offsetType(XZ)：Mth.getSeed(x,0,z) 取两个 4 位数，各映射到 ±0.25 格，再夹到
	getMaxHorizontalOffset：竹子 0.25、滴水石锥 0.125），偏移完看盖住墙的哪几块（UNDER 位，见“按面的支撑位图”）。
	柱子宽：竹子 3 像素（SHAPE_COLLISION）；滴水石锥按粗细 6/8/10/12，朝上的尖 0..11、朝下的尖 5..16（不贴底，什么都不盖）*/
	double w;
	float maxh;
	if(u->base=="bamboo"){
		w=3;
		maxh=0.25f;
	}else{
		const char *t=get_Prop(u,"thickness");
		if(!t||!strcmp(t,"tip")){
			if(is_PropValue(u,"vertical_direction","down")){
				return 0;
			}
			w=6;
		}else if(!strcmp(t,"tip_merge")){
			w=6;
		}else if(!strcmp(t,"frustum")){
			w=8;
		}else if(!strcmp(t,"middle")){
			w=10;
		}else if(!strcmp(t,"base")){
			w=12;
		}else{
			return 0;
		}
		maxh=0.125f;
	}
	int32_t xm=(int32_t)((uint32_t)x*3129871u);/*Java 里 x*3129871 是 int 乘法，溢出照绕*/
	uint64_t sd=(uint64_t)(int64_t)xm^((uint64_t)(int64_t)z*116129781ull);
	sd=sd*sd*42317861ull+sd*11ull;
	int64_t seed=(int64_t)sd>>16;
	double ox=std::clamp(((double)((float)(seed&15)/15.0f)-0.5)*0.5,-(double)maxh,(double)maxh);
	double oz=std::clamp(((double)((float)((seed>>8)&15)/15.0f)-0.5)*0.5,-(double)maxh,(double)maxh);
	double x0=(8-w/2)/16+ox,x1=(8+w/2)/16+ox,z0=(8-w/2)/16+oz,z1=(8+w/2)/16+oz;
	auto covers=[&](double a0,double a1,double b0,double b1){/*测试区 [a0,a1]×[b0,b1]（像素）在不在柱子里*/
		const double e=1e-7;
		return x0<=a0/16+e&&x1>=a1/16-e&&z0<=b0/16+e&&z1>=b1/16-e;
	};
	uint32_t r=0;
	if(covers(7,9,7,9)){
		r|=SH_UNDER_POST;
	}
	if(covers(7,9,0,9)){
		r|=sh_Under(NB_N);
	}
	if(covers(7,9,7,16)){
		r|=sh_Under(NB_S);
	}
	if(covers(7,16,7,9)){
		r|=sh_Under(NB_E);
	}
	if(covers(0,9,7,9)){
		r|=sh_Under(NB_W);
	}
	return r;
}
static int judge_Wall(const Fix_Def &d,Rules_Ctx &c){/*墙（WallBlock.updateShape）：四个方向先定连不连，连着的那边上面那格的碰撞箱底面
	盖住那条臂就是 tall、不然 low；柱子（shouldRaisePost）：上面是立着柱子的墙 → 立；四边都不连、或者有一边连而对面不连（拐角/端头）→ 立；
	一条直线上两边都是 tall → 不立；剩下的看上面是不是 #wall_post_override（火把/告示牌/旗帜/压力板…）或者盖住了柱子那块*/
	(void)d;
	const Blk_Info *u=get_Neighbor(c,NB_U);
	if(!u){
		return FX_KEEP;
	}
	if(!has_Link(u,CK_VANILLA)){
		return FX_KEEP;/*上面是模组方块：碰撞箱/标签不知道*/
	}
	uint32_t cover=(u->base=="bamboo"||is_Speleothem(u))?get_OffsetUnder(u,c.x,c.z):get_Shape(u)&SH_UNDER_ALL;
	static const char *keys[5]={"east","west","south","north","up"};/*前四个和 nb_h 同一个顺序：东 西 南 北*/
	const char *vals[5];
	bool none[4],tall[4];
	for(int i=0;i<4;i++){
		const Blk_Info *n=get_Neighbor(c,nb_h[i]);
		if(!n){
			return FX_KEEP;
		}
		int on=get_LinkTo(n,nb_h[i],LK_WALL,false);
		if(on<0){
			return FX_KEEP;
		}
		none[i]=!on;
		tall[i]=on&&(cover&sh_Under(nb_h[i]));
		vals[i]=none[i]?"none":tall[i]?"tall":"low";
	}
	bool post;
	if(has_Link(u,CK_WALL)&&!is_PropValue(u,"up","false")){
		post=true;
	}else if((none[0]&&none[1]&&none[2]&&none[3])||none[0]!=none[1]||none[2]!=none[3]){
		post=true;
	}else if((tall[0]&&tall[1])||(tall[2]&&tall[3])){
		post=false;
	}else{
		post=has_Link(u,CK_POST)||(cover&SH_UNDER_POST);
	}
	vals[4]=post?"true":"false";
	return set_LinkState(c,edit_State(c.self,keys,vals,5));
}
/*外观转换（活得下去以后，原版 updateShape 还会按邻居换成同一族的另一种）：
  藤头/藤身（GrowingPlantHeadBlock/BodyBlock：海带、缠怨藤往上长，垂泪藤、洞穴藤蔓往下长）——
    藤头长的方向那格是同族（藤头或藤身）就变藤身；藤身长的方向那格不是同族就变藤头（age 原版随机 0..24，这里按坐标散列）；
    洞穴藤蔓两种互换时照留 berries；
  大型垂滴叶上面是大型垂滴叶 → 变茎（BigDripleafBlock.updateShape，withPropertiesOf：facing/waterlogged 照留）；
  竹笋上面是竹子 → 变竹子默认状态（BambooSaplingBlock.updateShape）；
  竹子上面那节 age 比自己大 → 自己 age 换下一个（BambooStalkBlock.updateShape，state.cycle(AGE)：0→1）。
  这几种只跟着邻居走，邻居不变判两次结果一样；“长的方向那格是不是同族”只会从是变成不是（fixer 不放方块），
  所以每格最多转两次（收敛见 rules.hpp）*/
struct Grow_Def{const char *head,*body;int grow;bool berries;};/*一族藤：藤头名、藤身名、往哪边长、有没有 berries 属性*/
static const Grow_Def grow_Defs[]={
	{"kelp","kelp_plant",NB_U,false},
	{"twisting_vines","twisting_vines_plant",NB_U,false},
	{"weeping_vines","weeping_vines_plant",NB_D,false},
	{"cave_vines","cave_vines_plant",NB_D,true},
};
static int judge_Convert(Rules_Ctx &c){/*外观转换（上面那段说明）：只在规则判“留着”以后调；不属于这几族的直接留着*/
	std::string_view n=c.self->base;
	for(const Grow_Def &g:grow_Defs){
		bool head=n==g.head,body=n==g.body;
		if(!head&&!body){
			continue;
		}
		const Blk_Info *t=get_Neighbor(c,g.grow);
		if(!t){
			return FX_KEEP;
		}
		bool fam=t->base==g.head||t->base==g.body;
		const char *berries=g.berries?get_Prop(c.self,"berries"):NULL;
		if(head&&fam){
			Block o{nbt_String(make_Name(c.self,g.body))};
			if(g.berries){
				o.properties.set_String("berries",berries?berries:"false");
			}
			return set_OutBlock(c,std::move(o),false);
		}
		if(body&&!fam){
			Block o{nbt_String(make_Name(c.self,g.head))};
			o.properties.set_String("age",std::to_string(get_PosRandom(c,25)));
			if(g.berries){
				o.properties.set_String("berries",berries?berries:"false");
			}
			return set_OutBlock(c,std::move(o),false);
		}
		return FX_KEEP;
	}
	if(n=="big_dripleaf"){
		const Blk_Info *u=get_Neighbor(c,NB_U);
		if(u&&u->base=="big_dripleaf"){
			Block o{nbt_String(make_Name(c.self,"big_dripleaf_stem"))};
			const char *f=get_Prop(c.self,"facing");
			const char *w=get_Prop(c.self,"waterlogged");
			o.properties.set_String("facing",f?f:"north");
			o.properties.set_String("waterlogged",w?w:"false");
			return set_OutBlock(c,std::move(o),false);
		}
		return FX_KEEP;
	}
	if(n=="bamboo_sapling"){
		const Blk_Info *u=get_Neighbor(c,NB_U);
		if(u&&u->base=="bamboo"){
			Block o{nbt_String(make_Name(c.self,"bamboo"))};
			o.properties.set_String("age","0");
			o.properties.set_String("leaves","none");
			o.properties.set_String("stage","0");
			return set_OutBlock(c,std::move(o),false);
		}
		return FX_KEEP;
	}
	if(n=="bamboo"){
		const Blk_Info *u=get_Neighbor(c,NB_U);
		const char *ua=u&&u->base=="bamboo"?get_Prop(u,"age"):NULL;
		const char *sa=get_Prop(c.self,"age");
		if(ua&&sa&&atoi(ua)>atoi(sa)){
			const char *k[1]={"age"};
			const char *v[1]={!strcmp(sa,"0")?"1":"0"};/*cycle：0→1（1 不会比别人小，到不了这里）*/
			return set_OutBlock(c,edit_State(c.self,k,v,1),false);
		}
		return FX_KEEP;
	}
	return FX_KEEP;
}
/*---- 只是样子的属性：蘑菇方块的面、音符盒的音色、树叶的 distance（滴水石锥粗细、脚手架 distance 在各自的存活规则里） ----*/
static int judge_Mushroom(const Fix_Def &d,Rules_Ctx &c){/*蘑菇方块/蘑菇柄（HugeMushroomBlock.updateShape）：挨着同一种方块（is(this)）的面改成 false；
	别的面不动（游戏只在放下时按邻居算，之后只关不开）。收敛：只关不开*/
	static const char *face[6]={"east","west","up","down","south","north"};/*按 NB_* 顺序*/
	(void)d;
	Block o=copy_State(c.self);
	for(int i=0;i<6;i++){
		const Blk_Info *n=get_Neighbor(c,i);
		if(n&&n->name==c.self->name&&!is_PropValue(c.self,face[i],"false")){
			o.properties.set_String(face[i],"false");
		}
	}
	return set_LinkState(c,std::move(o));
}
static int judge_Note(const Fix_Def &d,Rules_Ctx &c){/*音符盒（NoteBlock.setInstrument）：上面那格的音色 worksAboveNoteBlock（头颅）就用它；
	不然用下面那格的（下面是头颅当 harp）。上下是模组方块（音色不知道）不动。收敛：只看上下两格是什么方块，不看它们的状态*/
	(void)d;
	const Blk_Info *u=get_Neighbor(c,NB_U),*b=get_Neighbor(c,NB_D);
	if(!u||!b||!is_Vanilla(u)||!is_Vanilla(b)){
		return FX_KEEP;
	}
	int i=get_Instr(u);
	if(i<INSTR_MOB_HEAD){
		i=get_Instr(b);
		if(i>=INSTR_MOB_HEAD){
			i=0;
		}
	}
	const char *k[1]={"instrument"},*val[1]={instr_Name[i]};
	return set_LinkState(c,edit_State(c.self,k,val,1));
}
static int judge_Leaves(const Fix_Def &d,Rules_Ctx &c){/*树叶（LeavesBlock.updateDistance）：distance＝min(7, 六邻的 distance+1)；
	邻居是 #prevents_nearby_leaf_decay（原木/菌柄）算 0，树叶算它存的 distance，别的（脚手架也是）算 7。模组方块邻居（标签不知道）不动。distance=7、persistent=false 的游戏会慢慢腐烂掉，这里不拆。
	收敛：同脚手架，有上限的最短路*/
	(void)d;
	int dist=7;
	for(int i=0;i<6;i++){
		const Blk_Info *n=get_Neighbor(c,i);
		if(!n){
			return FX_KEEP;
		}
		if(!is_Vanilla(n)&&!is_Air(n)){
			return FX_KEEP;
		}
		int v=7;
		if(is_LeafKeep(n)){
			v=0;
		}else if(has_Suffix(n->base,"_leaves")){/*只认树叶自己的 distance：脚手架那个 distance 是另一个属性对象，hasProperty 按对象认（对拍核过）*/
			const char *s=get_Prop(n,"distance");
			if(s&&s[0]>='1'&&s[0]<='7'&&!s[1]){
				v=s[0]-'0';
			}
		}
		dist=std::min(dist,v+1);
	}
	char ds[2]={(char)('0'+dist),0};
	const char *k[1]={"distance"},*val[1]={ds};
	return set_LinkState(c,edit_State(c.self,k,val,1));
}
typedef int (*Fix_Fn)(const Fix_Def&,Rules_Ctx&);
static const Fix_Fn judge_Fn[RULE_COUNT]={
	NULL,judge_Below,judge_2X,judge_Vine,judge_Face6,judge_Side,judge_Above,judge_Rim,judge_Hang,judge_Hang2,judge_Door,
	judge_Cocoa,judge_Stem,judge_Drip,judge_Bell,judge_Scaffolding,judge_SmallDripleaf,judge_Propagule,judge_Chorus,
	judge_ChorusPlant,judge_Snow,judge_Frost,judge_Falling,judge_Bed,judge_PistonHead,judge_PaleCarpet,judge_Fire,judge_Portal,
	judge_Fence,judge_Wall,judge_Bars,judge_Gate,judge_Chest,judge_Snowy,judge_Mushroom,judge_Note,judge_Leaves
};
static int call_Def(const Fix_Def &d,Rules_Ctx &c){/*按规则号分派到 judge_Fn 里对应的函数；“不管”和越界的规则号都是留着*/
	if(d.rule==RULE_NONE||d.rule>=RULE_COUNT||!judge_Fn[d.rule]){
		return FX_KEEP;
	}
	return judge_Fn[d.rule](d,c);
}

