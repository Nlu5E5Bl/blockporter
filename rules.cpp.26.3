/*==================== 0. 插件私有：放在 Blk_Info::priv 里的东西（主机不读，rules.hpp 里也没有） ====================*/
/*支撑三档：一条规则要求"下面/上面/侧面"达到哪一档才算撑得住。
  2/3 档是"按面"算的（见 4. 的形状位图）：同一个方块，不同方向的面可能给出不同答案。*/
enum{S_NONE=0, /*压根不是方块（空气/水/火/传送门）*/
     S_THIN=1, /*薄片：撑不住任何东西（草、花、火把、铁轨、告示牌…）*/
     S_PART=2, /*"中心支撑"那一档：栅栏/墙/箱子（上下）、上半砖顶面/下半砖底面…*/
     S_FULL=3};/*整面：原版 isFaceSturdy(FULL) 够得着的那一面*/
enum{PF_MAGMA=1,    /*岩浆块：海带/海草下面不能是它*/
     PF_WATER_SRC=2, /*水源（level=0），或含水方块/水草海带里面的水*/
     PF_REPLACE=4,   /*BlockState.canBeReplaced()：重力方块下面是它就掉（FallingBlock.isFree）*/
     PF_LIQUID=8,    /*BlockState.liquid()：水/岩浆/气泡柱（重力方块下面、仙人掌上面）*/
     PF_BURN=16};    /*FireBlock.canBurn：火能靠它活（含水的不算）*/
enum{P_SHAPE=0,/*priv[0]：按面的支撑/碰撞位图（SH_*，见 4.）*/
     P_SETS=1, /*priv[1]：命中哪几个支持集（set_List 的位）*/
     P_DEF=2,  /*priv[2]：规则表下标+1（0＝不用管；主机造的空气占位全是0，正好不用管）*/
     P_MISC=3};/*priv[3]：支撑档 S_*（低8位）| PF_*（再往上8位）| CK_*（再往上8位）| 音符盒音色（24..28 位，NoteBlockInstrument 的序号）
                | 树叶当 distance 0 的（第 29 位，#prevents_nearby_leaf_decay）*/
/*栅栏/墙连不连得上它（FenceBlock/WallBlock.connectsTo、WallBlock.shouldRaisePost 要认的那几类方块，见 5. 里“栅栏/墙的连接”那一节）*/
enum{CK_FENCE=1,  /*#fences*/
     CK_WOODEN=2, /*#wooden_fences（木栅栏只和木栅栏连，下界砖栅栏只和下界砖栅栏连）*/
     CK_WALL=4,   /*#walls（26.1.1 里正好是全部 WallBlock）*/
     CK_BARS=8,   /*IronBarsBlock：铁栏杆/铜栏杆/玻璃板/染色玻璃板*/
     CK_GATE=16,  /*FenceGateBlock*/
     CK_NOLINK=32,/*Block.isExceptionForConnection：整面也不连（树叶/屏障/南瓜/雕刻南瓜/南瓜灯/西瓜/潜影盒）*/
     CK_POST=64,  /*#wall_post_override：墙上面是它就立柱子（火把/绊线/告示牌/旗帜/压力板/仙人掌花）*/
     CK_VANILLA=128};/*原版方块（模组方块的标签/形状不知道：栅栏/墙挨着它就不重算）*/
/*从 priv 里取东西的几个小函数（b 为 NULL 时都给“什么都没有”）*/
static uint32_t get_Shape(const Blk_Info *b){return b?b->priv[P_SHAPE]:0;}/*形状位图（SH_ 开头的那些位）*/
static uint32_t get_Sets(const Blk_Info *b){return b?b->priv[P_SETS]:0;}/*命中的支持集*/
static int get_Def(const Blk_Info *b){return b?(int)b->priv[P_DEF]-1:-1;}/*规则表下标，-1=不管*/
static int get_Lev(const Blk_Info *b){return b?(int)(b->priv[P_MISC]&0xFFu):S_NONE;}/*支撑档（S_NONE..S_FULL）*/
static bool has_Kind(const Blk_Info *b,unsigned k){return b&&((b->priv[P_MISC]>>8)&k);}/*有没有 PF_ 里的某一位*/
static bool has_Link(const Blk_Info *b,unsigned k){return b&&((b->priv[P_MISC]>>16)&k);}/*有没有 CK_ 里的某一位*/
static int get_Instr(const Blk_Info *b){return b?(int)((b->priv[P_MISC]>>24)&31u):0;}/*音符盒放在它旁边时取的音色（序号，0=harp）*/
static bool is_LeafKeep(const Blk_Info *b){return b&&((b->priv[P_MISC]>>29)&1u);}/*树叶看它当 distance 0（原木/菌柄这些）*/
static bool is_Vanilla(const Blk_Info *b){return b&&((b->priv[P_MISC]>>16)&CK_VANILLA);}/*原版方块（模组方块的标签、属性不知道）*/

/*==================== 1. 取名字/属性/小判断 ====================*/
static std::string_view strip_Spacename(std::string_view n){/*冒号后面那段（自带命名空间的mod方块会拿到原样）*/
	size_t p=n.find(':');
	return p==std::string_view::npos?n:n.substr(p+1);
}
static bool has_Suffix(std::string_view n,const char *suf){/*名字是不是以suf结尾*/
	size_t l=strlen(suf);
	return n.size()>=l&&!memcmp(n.data()+n.size()-l,suf,l);
}
static bool match_Pattern(const char *pat,std::string_view n){/*支持集/规则表里的名字：最多一个*，
	*前面的是前缀、后面的是后缀（"*_slab"、"potted_*"、"dead_*_coral"）；没有*＝全等*/
	size_t pl=strlen(pat);
	if(!pl){
		return false;
	}
	const char *star=strchr(pat,'*');
	if(!star){
		return n.size()==pl&&!memcmp(n.data(),pat,pl);
	}
	size_t pre=(size_t)(star-pat),suf=pl-pre-1;
	return n.size()>=pre+suf&&!memcmp(n.data(),pat,pre)&&!memcmp(n.data()+n.size()-suf,star+1,suf);
}

