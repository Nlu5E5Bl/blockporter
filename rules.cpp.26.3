static std::unordered_map<std::string_view,uint8_t> instr_Map;
static std::unordered_map<std::string_view,bool> leafkeep_Map;
static void split_Names(const char *s,uint8_t v,std::unordered_map<std::string_view,uint8_t> *m,std::unordered_map<std::string_view,bool> *b){/*空格隔开的名字表拆进 map（string_view 指在字符串常量里）*/
	std::string_view a(s);
	while(!a.empty()){
		size_t sp=a.find(' ');
		std::string_view w=a.substr(0,sp);
		if(!w.empty()){
			if(m){
				(*m)[w]=v;
			}
			if(b){
				(*b)[w]=true;
			}
		}
		if(sp==std::string_view::npos){
			break;
		}
		a=a.substr(sp+1);
	}
}
static void init_GenTables(){/*第一次用的时候把生成的表拆开；只建一次*/
	if(!instr_Map.empty()||!leafkeep_Map.empty()){
		return;
	}
	for(int i=1;i<(int)(sizeof(instr_Blocks)/sizeof(instr_Blocks[0]));i++){
		split_Names(instr_Blocks[i],(uint8_t)i,&instr_Map,NULL);
	}
	split_Names(leafkeep_Blocks,1,NULL,&leafkeep_Map);
}
